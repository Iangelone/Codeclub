---
import {
  ArrowLeft,
  ArrowRight,
  Bug,
  Command,
  Eye,
  FilePlus,
  FolderOpen,
  HelpCircle,
  Keyboard,
  Minus,
  PiggyBank,
  PanelLeft,
  PanelTop,
  PanelRight,
  Save,
  Scissors,
  Settings,
  Square,
  Terminal,
  Undo2,
  X,
} from "lucide-astro";
---

<header class="relative z-[100] col-span-full h-[36px] grid grid-cols-[auto_1fr_auto_138px] bg-[var(--color-bg)] border-b border-[var(--color-surface-10)] select-none">
  <div class="flex items-center h-full pl-[6px]">
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Toggle sidebar" data-action="toggle-sidebar">
      <PanelLeft size={15} strokeWidth={1.8} />
    </button>
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Back">
      <ArrowLeft size={15} strokeWidth={1.8} />
    </button>
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Forward">
      <ArrowRight size={15} strokeWidth={1.8} />
    </button>
    
    <nav class="flex items-center gap-[2px] ml-1 h-full relative" aria-label="Application menu">
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Archivo</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><FilePlus class="shrink-0" size={14} /> Nuevo archivo</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><FolderOpen class="shrink-0" size={14} /> Abrir carpeta</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Save class="shrink-0" size={14} /> Guardar</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Command class="shrink-0" size={14} /> Exportar</a>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Editar</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Undo2 class="shrink-0" size={14} /> Deshacer</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><ArrowRight class="shrink-0" size={14} /> Rehacer</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Scissors class="shrink-0" size={14} /> Cortar</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Settings class="shrink-0" size={14} /> Preferencias</a>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Ver</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><PanelLeft class="shrink-0" size={14} /> Panel lateral</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="toggle-terminal" data-project-required><Terminal class="shrink-0" size={14} /> Terminal</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Square class="shrink-0" size={14} /> Pantalla completa</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Eye class="shrink-0" size={14} /> Apariencia</a>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Ayuda</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><HelpCircle class="shrink-0" size={14} /> Documentación</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Keyboard class="shrink-0" size={14} /> Atajos</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Bug class="shrink-0" size={14} /> Reportar problema</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="https://ko-fi.com/codeclubide" target="_blank" rel="noreferrer">
            <PiggyBank class="shrink-0" size={14} /> Donación
          </a>
        </div>
      </div>

      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Testing</button>
        <div class="absolute top-[34px] left-0 min-w-[235px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="ask-user"><Bug class="shrink-0" size={14} /> Probar Ask user</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="subagents">Subagentes</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="approval">Aprobación de acciones</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="streaming">Streaming / pensamiento</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="todo">TODO y estados</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="plan-mode">Plan mode</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="quote">Generar cotización</button>
        </div>
      </div>
    </nav>
  </div>
  
  <div class="min-w-0 h-full drag-area" data-tauri-drag-region></div>
  
  <nav class="flex items-center gap-[1px] px-1" aria-label="Workspace controls">
    <button id="panel-single" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer is-active" type="button" aria-label="Panel simple">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
    </button>
    <button id="panel-split" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label="Panel doble">
      <PanelRight size={14} strokeWidth={1.8} />
    </button>
    <button id="panel-dock" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label="Mostrar dock" title="Mostrar dock">
      <PanelTop size={14} strokeWidth={1.8} />
    </button>
    <button id="topbar-terminal" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label="Terminal" data-action="toggle-terminal">
      <Terminal size={14} strokeWidth={1.8} />
    </button>
  </nav>
  
  <nav class="grid grid-cols-[repeat(3,46px)]" aria-label="Window controls">
    <button id="minimize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Minimize">
      <Minus class="block" size={14} strokeWidth={1.8} />
    </button>
    <button id="maximize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Maximize">
      <Square class="block" size={12} strokeWidth={1.8} />
    </button>
    <button id="close" class="close w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[#c42b1c] hover:text-white" type="button" aria-label="Close">
      <X class="block" size={14} strokeWidth={1.8} />
    </button>
  </nav>
</header>

<script>
  const topbarMenus = Array.from(document.querySelectorAll('.group\\/menu'));
  topbarMenus.forEach((menu) => {
    const trigger = menu.querySelector(':scope > button');
    menu.addEventListener('pointerenter', () => menu.classList.add('menu-open'));
    menu.addEventListener('pointerleave', () => {
      if (!menu.matches(':focus-within')) menu.classList.remove('menu-open');
    });
    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      topbarMenus.forEach((item) => { if (item !== menu) item.classList.remove('menu-open'); });
      menu.classList.toggle('menu-open');
    });
  });
  document.addEventListener('click', () => topbarMenus.forEach((menu) => menu.classList.remove('menu-open')));
  document.querySelectorAll('[data-testing-action]').forEach((button) => {
    button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('codeclub:testing-action', { detail: { action: button.dataset.testingAction } })));
  });
</script>

<style>
  .group\/menu > div {
    top: 28px !important;
  }

  .group\/menu::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    height: 8px;
    pointer-events: auto;
  }

  .group\/menu.menu-open > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  .group\/menu:hover > div,
  .group\/menu:focus-within > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }
</style>
