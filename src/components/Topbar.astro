---
import {
  ArrowLeft,
  ArrowRight,
  Bot,
  Bug,
  Eye,
  HelpCircle,
  Keyboard,
  Blocks,
  Folder,
  Minus,
  MessageSquarePlus,
  PiggyBank,
  PanelLeft,
  PanelTop,
  PanelRight,
  Square,
  Terminal,
  X,
} from "lucide-astro";
import { topbarTranslations } from "../lib/i18n";

const t = topbarTranslations.es;
---

<header class="acrylic-panel relative z-[100] col-span-full h-[36px] grid grid-cols-[auto_1fr_auto_138px] select-none">
  <div class="flex items-center h-full pl-[6px]">
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.toggleSidebar} data-i18n-aria="toggleSidebar" data-action="toggle-sidebar">
      <PanelLeft size={15} strokeWidth={1.8} />
    </button>
    <button id="navigate-back" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.back} data-i18n-aria="back">
      <ArrowLeft size={15} strokeWidth={1.8} />
    </button>
    <button id="navigate-forward" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.forward} data-i18n-aria="forward">
      <ArrowRight size={15} strokeWidth={1.8} />
    </button>
    
    <nav class="flex items-center gap-[2px] ml-1 h-full relative" aria-label={t.applicationMenu} data-i18n-aria="applicationMenu">
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" data-i18n="file">{t.file}</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="new-chat"><MessageSquarePlus class="shrink-0" size={14} /> <span data-i18n="newChat">{t.newChat}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-projects"><Folder class="shrink-0" size={14} /> <span data-i18n="projects">{t.projects}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-extensions"><Blocks class="shrink-0" size={14} /> <span data-i18n="extensions">{t.extensions}</span></a>
          <div data-recent-chats class="hidden border-t border-[var(--color-surface-10)] pt-2 mt-1">
            <div class="px-[10px] pb-1 text-[10px] uppercase tracking-[0.08em] text-[#666]" data-i18n="recentChats">{t.recentChats}</div>
            <div data-recent-chat-list class="flex flex-col gap-[3px]"></div>
          </div>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" data-i18n="view">{t.view}</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="toggle-sidebar"><PanelLeft class="shrink-0" size={14} /> <span data-i18n="sidePanel">{t.sidePanel}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="toggle-fullscreen"><Square class="shrink-0" size={14} /> <span data-i18n="fullscreen">{t.fullscreen}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-settings"><Eye class="shrink-0" size={14} /> <span data-i18n="appearance">{t.appearance}</span></a>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" data-i18n="help">{t.help}</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><HelpCircle class="shrink-0" size={14} /> <span data-i18n="documentation">{t.documentation}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Keyboard class="shrink-0" size={14} /> <span data-i18n="shortcuts">{t.shortcuts}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Bug class="shrink-0" size={14} /> <span data-i18n="reportProblem">{t.reportProblem}</span></a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="https://ko-fi.com/iangeldev" target="_blank" rel="noreferrer">
            <PiggyBank class="shrink-0" size={14} /> <span data-i18n="donation">{t.donation}</span>
          </a>
        </div>
      </div>

      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#eeeeee] hover:bg-[var(--color-surface-7)]" type="button" data-i18n="developer">{t.developer}</button>
        <div class="absolute top-[34px] left-0 min-w-[240px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-inspect" data-i18n="inspectWorkspace">{t.inspectWorkspace}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-memory" data-i18n="testMemory">{t.testMemory}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-plan" data-i18n="createPlan">{t.createPlan}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-edit" data-i18n="editFile">{t.editFile}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-browser" data-i18n="testBrowser">{t.testBrowser}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-diagnostics" data-i18n="diagnostics">{t.diagnostics}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-recovery" data-i18n="recoverError">{t.recoverError}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-computer" data-i18n="testComputerUse">{t.testComputerUse}</button>
        </div>
      </div>
      <div class="relative h-full flex items-center group/menu ml-1">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#eeeeee] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.assistant} data-i18n-aria="assistant" data-i18n="assistant">{t.assistant}</button>
        <div class="absolute top-[34px] left-0 min-w-[240px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-memory" data-i18n="testMemory">{t.testMemory}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-browser" data-i18n="testBrowser">{t.testBrowser}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="dev-diagnostics" data-i18n="diagnostics">{t.diagnostics}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="assistant-computer" data-i18n="assistantComputerTest">{t.assistantComputerTest}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="assistant-browser-cursor" data-i18n="assistantBrowserCursorTest">{t.assistantBrowserCursorTest}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="assistant-computer-cursor" data-i18n="assistantComputerCursorTest">{t.assistantComputerCursorTest}</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-action="toggle-computer-overlay" data-i18n="assistantComputerOverlay" data-i18n-active="assistantComputerOverlayActive" data-overlay-active="false" aria-pressed="false">{t.assistantComputerOverlay}</button>
        </div>
      </div>
    </nav>
  </div>
  
  <div class="min-w-0 h-full drag-area" data-tauri-drag-region></div>
  
  <nav class="flex items-center gap-[1px] px-1" aria-label={t.workspaceControls} data-i18n-aria="workspaceControls">
    <button id="panel-single" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[#2F2F2F] [&.is-active]:text-[#eeeeee] cursor-pointer is-active" type="button" aria-label={t.simplePanel} data-i18n-aria="simplePanel">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
    </button>
    <button id="panel-split" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[#2F2F2F] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label={t.splitPanel} data-i18n-aria="splitPanel">
      <PanelRight size={14} strokeWidth={1.8} />
    </button>
    <button id="panel-dock" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[#2F2F2F] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label={t.showDock} data-i18n-aria="showDock" title={t.showDock}>
      <PanelTop size={14} strokeWidth={1.8} />
    </button>
  </nav>
  
  <nav class="grid grid-cols-[repeat(3,46px)]" aria-label={t.windowControls} data-i18n-aria="windowControls">
    <button id="minimize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.minimize} data-i18n-aria="minimize">
      <Minus class="block" size={14} strokeWidth={1.8} />
    </button>
    <button id="maximize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label={t.maximize} data-i18n-aria="maximize">
      <Square class="block" size={12} strokeWidth={1.8} />
    </button>
    <button id="close" class="close w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[#c42b1c] hover:text-white" type="button" aria-label={t.close} data-i18n-aria="close">
      <X class="block" size={14} strokeWidth={1.8} />
    </button>
  </nav>
</header>

<script>
  import { LANGUAGE_STORAGE_KEY, topbarTranslations, type AppLanguage } from '../lib/i18n';

  const applyLanguage = (language: AppLanguage) => {
    const translations = topbarTranslations[language];
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
      const translationKey = element.dataset.overlayActive === 'true' && element.dataset.i18nActive ? element.dataset.i18nActive : element.dataset.i18n;
      if (!translationKey) return;
      const key = translationKey as keyof typeof translations;
      if (key in translations) element.textContent = translations[key];
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
      const key = element.dataset.i18nAria as keyof typeof translations;
      if (key in translations) {
        element.setAttribute('aria-label', translations[key]);
        if (element.hasAttribute('title')) element.setAttribute('title', translations[key]);
      }
    });
  };

  const savedLanguage = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
  applyLanguage(savedLanguage === 'en' ? 'en' : 'es');
  window.addEventListener('codeclub:language-change', (event) => {
    const language = (event as CustomEvent<{ language?: AppLanguage }>).detail?.language;
    if (language === 'es' || language === 'en') applyLanguage(language);
  });

  const topbarMenus = Array.from(document.querySelectorAll('.group\\/menu'));
  const publishNativeMenu = (menu, open) => window.dispatchEvent(new CustomEvent('codeclub:native-menu', { detail: { open: Boolean(open), element: menu.querySelector(':scope > div') } }));
  const setMenuState = (menu, open) => {
    menu.classList.toggle('menu-open', open);
    publishNativeMenu(menu, open);
  };
  const nativeMenuIsOpen = () => Boolean((window as Window & { __codeclubNativeMenuOpen?: boolean }).__codeclubNativeMenuOpen);
  topbarMenus.forEach((menu) => {
    const trigger = menu.querySelector(':scope > button');
    menu.addEventListener('pointerenter', () => setMenuState(menu, true));
    menu.addEventListener('pointerleave', () => {
      if (!menu.matches(':focus-within') && !nativeMenuIsOpen()) setMenuState(menu, false);
    });
    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      topbarMenus.forEach((item) => { if (item !== menu) setMenuState(item, false); });
      setMenuState(menu, !menu.classList.contains('menu-open'));
    });
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a, button, [data-testing-action]')) setMenuState(menu, false);
    });
  });
  document.addEventListener('click', () => topbarMenus.forEach((menu) => setMenuState(menu, false)));
  document.querySelectorAll('[data-testing-action]').forEach((button) => {
    button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('codeclub:testing-action', { detail: { action: button.dataset.testingAction } })));
  });
  const overlayButton = document.querySelector<HTMLElement>('[data-action="toggle-computer-overlay"]');
  const updateOverlayButton = (active: boolean) => {
    if (!overlayButton) return;
    overlayButton.dataset.overlayActive = String(active);
    overlayButton.setAttribute('aria-pressed', String(active));
    overlayButton.classList.toggle('bg-[#2F2F2F]', active);
    overlayButton.classList.toggle('text-[#eeeeee]', active);
    const language = window.localStorage.getItem(LANGUAGE_STORAGE_KEY) === 'en' ? 'en' : 'es';
    const key = (active ? overlayButton.dataset.i18nActive : overlayButton.dataset.i18n) as keyof typeof topbarTranslations[typeof language];
    if (key && key in topbarTranslations[language]) overlayButton.textContent = topbarTranslations[language][key];
  };
  window.addEventListener('codeclub:computer-overlay-state', (event) => updateOverlayButton(Boolean((event as CustomEvent<{ active?: boolean }>).detail?.active)));
</script>

<style>
  .testing-menu button[data-testing-action^="braille-"],
  .testing-menu button[data-testing-action="markdown-rendering"],
  .testing-menu button[data-testing-action="test-all"] {
    display: none;
  }

  .group\/menu > div {
    top: 28px !important;
  }

  .group\/menu::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    height: 8px;
    pointer-events: auto;
  }

  .group\/menu.menu-open > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  .group\/menu:hover > div,
  .group\/menu:focus-within > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }
</style>
