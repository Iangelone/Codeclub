---
import {
  ArrowLeft,
  ArrowRight,
  Bot,
  Bug,
  Eye,
  HelpCircle,
  Keyboard,
  Blocks,
  Folder,
  Minus,
  MessageSquarePlus,
  PiggyBank,
  PanelLeft,
  PanelTop,
  PanelRight,
  Square,
  Target,
  Terminal,
  X,
} from "lucide-astro";
---

<header class="acrylic-panel relative z-[100] col-span-full h-[36px] grid grid-cols-[auto_1fr_auto_138px] select-none">
  <div class="flex items-center h-full pl-[6px]">
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Toggle sidebar" data-action="toggle-sidebar">
      <PanelLeft size={15} strokeWidth={1.8} />
    </button>
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Back">
      <ArrowLeft size={15} strokeWidth={1.8} />
    </button>
    <button class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Forward">
      <ArrowRight size={15} strokeWidth={1.8} />
    </button>
    
    <nav class="flex items-center gap-[2px] ml-1 h-full relative" aria-label="Application menu">
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Archivo</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="new-chat"><MessageSquarePlus class="shrink-0" size={14} /> Nuevo chat</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-projects"><Folder class="shrink-0" size={14} /> Proyectos</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-businesses"><Target class="shrink-0" size={14} /> Agentes</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-extensions"><Blocks class="shrink-0" size={14} /> Complementos</a>
          <div data-recent-chats class="hidden border-t border-[var(--color-surface-10)] pt-2 mt-1">
            <div class="px-[10px] pb-1 text-[10px] uppercase tracking-[0.08em] text-[#666]">Últimos chats</div>
            <div data-recent-chat-list class="flex flex-col gap-[3px]"></div>
          </div>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Ver</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="toggle-sidebar"><PanelLeft class="shrink-0" size={14} /> Panel lateral</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="toggle-fullscreen"><Square class="shrink-0" size={14} /> Pantalla completa</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#" data-action="open-settings"><Eye class="shrink-0" size={14} /> Apariencia</a>
        </div>
      </div>
      
      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Ayuda</button>
        <div class="absolute top-[34px] left-0 min-w-[210px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><HelpCircle class="shrink-0" size={14} /> Documentación</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Keyboard class="shrink-0" size={14} /> Atajos</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="#"><Bug class="shrink-0" size={14} /> Reportar problema</a>
          <a class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs no-underline hover:bg-[var(--color-surface-7)] hover:text-white" href="https://ko-fi.com/codeclubide" target="_blank" rel="noreferrer">
            <PiggyBank class="shrink-0" size={14} /> Donación
          </a>
        </div>
      </div>

      <div class="relative h-full flex items-center group/menu">
        <button class="h-[28px] px-[9px] text-xs border-0 rounded-md bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button">Testing</button>
        <div class="absolute top-[34px] left-0 min-w-[240px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20">
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="web-folder">1. Verificar carpeta del sitio</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="web-page">2. Armar la página web</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="web-debug">3. Abrir y debuguear</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="web-quote">4. Preparar cotización</button>
          <button class="flex min-h-[30px] items-center rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="web-charge">5. Preparar cobro</button>
        </div>
        <div class="testing-menu hidden absolute top-[34px] left-0 min-w-[265px] flex flex-col gap-[3px] p-2 border border-[var(--color-surface-10)] rounded-lg bg-[rgba(18,18,18,0.96)] shadow-[0_18px_54px_rgba(0,0,0,0.38)] opacity-0 pointer-events-none -translate-y-1 transition-all duration-120 ease-out group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 z-20" style="display:none">
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-swarm"><Bot class="shrink-0" size={14} /> Test swarm e hijos</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-artifacts"><Target class="shrink-0" size={14} /> Test proyectos y artifacts</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-programmatic"><Terminal class="shrink-0" size={14} /> Test acciones programáticas</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-custom-control"><Eye class="shrink-0" size={14} /> Test control custom</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-timeline"><MessageSquarePlus class="shrink-0" size={14} /> Test timeline y resumen</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-browser"><Eye class="shrink-0" size={14} /> Test navegador seguro</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-retry"><X class="shrink-0" size={14} /> Test retry y error</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-capacity"><Bot class="shrink-0" size={14} /> Test slots del swarm</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="test-all"><Bug class="shrink-0" size={14} /> Test · verificar todo</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-tools"><Bug class="shrink-0" size={14} /> Braille · atlas de tools</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-specialists"><Bot class="shrink-0" size={14} /> Braille · especialistas</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-business"><PiggyBank class="shrink-0" size={14} /> Braille · Economía</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-error"><X class="shrink-0" size={14} /> Braille · estado error</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-browser"><Eye class="shrink-0" size={14} /> Braille · navegador</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="braille-complete"><MessageSquarePlus class="shrink-0" size={14} /> Braille · secuencia completa</button>
          <button class="flex min-h-[30px] items-center gap-[9px] rounded-md px-[10px] text-[#bdbdbd] text-xs text-left hover:bg-[var(--color-surface-7)] hover:text-white" type="button" data-testing-action="markdown-rendering"><Bug class="shrink-0" size={14} /> Markdown · render completo</button>
        </div>
      </div>
    </nav>
  </div>
  
  <div class="min-w-0 h-full drag-area" data-tauri-drag-region></div>
  
  <nav class="flex items-center gap-[1px] px-1" aria-label="Workspace controls">
    <button id="panel-single" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer is-active" type="button" aria-label="Panel simple">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
    </button>
    <button id="panel-split" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label="Panel doble">
      <PanelRight size={14} strokeWidth={1.8} />
    </button>
    <button id="panel-dock" class="w-[30px] h-[28px] grid place-items-center border-0 rounded-md bg-transparent text-[#d8d8d8]/52 transition-colors duration-120 hover:bg-[var(--color-surface-7)] hover:text-[#d8d8d8] [&.is-active]:bg-[var(--color-surface-6)] [&.is-active]:text-[#eeeeee] cursor-pointer" type="button" aria-label="Mostrar dock" title="Mostrar dock">
      <PanelTop size={14} strokeWidth={1.8} />
    </button>
  </nav>
  
  <nav class="grid grid-cols-[repeat(3,46px)]" aria-label="Window controls">
    <button id="minimize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Minimize">
      <Minus class="block" size={14} strokeWidth={1.8} />
    </button>
    <button id="maximize" class="w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[var(--color-surface-7)]" type="button" aria-label="Maximize">
      <Square class="block" size={12} strokeWidth={1.8} />
    </button>
    <button id="close" class="close w-[46px] h-[36px] grid place-items-center border-0 rounded-none bg-transparent text-[#d8d8d8] hover:bg-[#c42b1c] hover:text-white" type="button" aria-label="Close">
      <X class="block" size={14} strokeWidth={1.8} />
    </button>
  </nav>
</header>

<script>
  const topbarMenus = Array.from(document.querySelectorAll('.group\\/menu'));
  topbarMenus.forEach((menu) => {
    const trigger = menu.querySelector(':scope > button');
    menu.addEventListener('pointerenter', () => menu.classList.add('menu-open'));
    menu.addEventListener('pointerleave', () => {
      if (!menu.matches(':focus-within')) menu.classList.remove('menu-open');
    });
    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      topbarMenus.forEach((item) => { if (item !== menu) item.classList.remove('menu-open'); });
      menu.classList.toggle('menu-open');
    });
  });
  document.addEventListener('click', () => topbarMenus.forEach((menu) => menu.classList.remove('menu-open')));
  document.querySelectorAll('[data-testing-action]').forEach((button) => {
    button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('codeclub:testing-action', { detail: { action: button.dataset.testingAction } })));
  });
</script>

<style>
  .testing-menu button[data-testing-action^="braille-"],
  .testing-menu button[data-testing-action="markdown-rendering"],
  .testing-menu button[data-testing-action="test-all"] {
    display: none;
  }

  .group\/menu > div {
    top: 28px !important;
  }

  .group\/menu::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    height: 8px;
    pointer-events: auto;
  }

  .group\/menu.menu-open > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  .group\/menu:hover > div,
  .group\/menu:focus-within > div {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }
</style>
