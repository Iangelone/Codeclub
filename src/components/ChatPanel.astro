---
import ChatInterface from "./ChatInterface.tsx";
import { models, providers } from "../lib/ai-catalog";

const defaultProvider = providers.length > 0 ? providers[0] : null;
const defaultModel = defaultProvider ? (models.find((model) => model.providerId === defaultProvider.id) ?? models[0]) : null;
const catalog = [
  ...providers.map((provider) => ({ ...provider, type: "provider" })),
  ...models.map((model) => ({ ...model, type: "model" })),
];
---

<section class="chat-panel" aria-label="Chat">
  <ChatInterface client:load catalog={catalog} defaultProvider={defaultProvider} defaultModel={defaultModel} />
</section>

<style is:global>
  .chat-panel {
    position: relative;
    min-width: 0;
    min-height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .braille-spinner {
    position: relative;
    color: #c7cbff;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    line-height: 1;
    opacity: 0.78;
    text-shadow:
      0 0 10px rgba(123, 130, 255, 0.42),
      0 0 18px rgba(255, 117, 181, 0.18);
  }

  .braille-spinner::before {
    content: "\280b";
    font-size: 18px;
    animation: braille-frame 880ms steps(1, end) infinite;
  }

  @keyframes braille-frame {
    0% { content: "\280b"; }
    12.5% { content: "\2819"; }
    25% { content: "\2839"; }
    37.5% { content: "\2838"; }
    50% { content: "\283c"; }
    62.5% { content: "\2834"; }
    75% { content: "\2826"; }
    87.5% { content: "\2827"; }
  }
</style>
