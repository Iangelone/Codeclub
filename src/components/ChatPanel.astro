---
import WorkspaceManager from "./WorkspaceManager.tsx";
import { models, providers } from "../lib/ai-catalog";

const defaultProvider = providers.length > 0 ? providers[0] : null;
const defaultModel = defaultProvider ? (models.find((model) => model.providerId === defaultProvider.id) ?? models[0]) : null;
const catalog = [
  ...providers.map((provider) => ({ ...provider, type: "provider" })),
  ...models.map((model) => ({ ...model, type: "model" })),
];
---

<section class="relative h-full min-w-0 min-h-0 grid place-items-stretch overflow-hidden" aria-label="Chat">
  <WorkspaceManager client:load catalog={catalog} defaultProvider={defaultProvider} defaultModel={defaultModel} />
</section>

<style is:global>


  .terminal-floating-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 999;
    animation: terminalFadeIn 180ms ease;
  }

  @keyframes terminalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .terminal-floating {
    position: fixed;
    width: min(760px, calc(100vw - 64px));
    display: grid;
    grid-template-rows: 34px minmax(0, 1fr);
    border: 1px solid #202020;
    border-radius: 12px;
    background: #2F2F2F;
    backdrop-filter: blur(32px) saturate(1.4);
    -webkit-backdrop-filter: blur(32px) saturate(1.4);
    box-shadow: none;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.97);
    transition:
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .terminal-floating.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .terminal-floating .terminal-resize-handle {
    opacity: 0;
  }

  .terminal-floating.is-open .terminal-resize-handle {
    opacity: 1;
  }

  .terminal-resize-handle {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 7px;
    z-index: 10;
    cursor: ns-resize;
  }

  .terminal-resize-handle::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
    width: 36px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.07);
    transition: background 120ms ease, width 120ms ease;
  }

  .terminal-resize-handle:hover::after {
    background: rgba(255, 255, 255, 0.18);
    width: 48px;
  }

  .terminal-floating-bar {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px 12px 0 0;
    background: transparent;
    position: relative;
    z-index: 5;
    cursor: grab;
    user-select: none;
  }

  .terminal-floating-bar:active {
    cursor: grabbing;
  }

  .terminal-floating button {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    color: #d8d8d8;
    font: inherit;
  }

  .terminal-tab,
  .terminal-new-tab,
  .terminal-actions button {
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(216, 216, 216, 0.62) !important;
    font-size: 10px;
    line-height: 1;
  }

  .terminal-tab:hover:not(.is-active),
  .terminal-new-tab:hover,
  .terminal-actions button:hover:not(:disabled),
  .terminal-shell-menu button:hover,
  .terminal-empty button:hover {
    background: rgba(255, 255, 255, 0.055);
    color: #eeeeee;
  }

  .terminal-tabs {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #3a3a3a transparent;
    height: 40px;
  }

  .terminal-tabs::-webkit-scrollbar {
    width: 7px;
    height: 7px;
  }

  .terminal-tabs::-webkit-scrollbar-track {
    background: transparent;
  }

  .terminal-tabs::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: #3a3a3a;
    background-clip: padding-box;
  }

  .terminal-tabs::-webkit-scrollbar-thumb:hover {
    background: #505050;
    background-clip: padding-box;
  }

  .terminal-tab {
    flex: 0 0 auto;
    min-width: 92px;
    max-width: 174px;
    gap: 6px;
    padding: 0 7px 0 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    position: relative;
  }

  .terminal-tab-main {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    color: inherit;
    text-align: left;
  }

  .terminal-tab-close {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 4px;
    color: inherit;
    opacity: 0.58;
  }

  .terminal-tab-close:hover {
    background: rgba(0, 0, 0, 0.16);
    opacity: 1;
  }

  .terminal-tab.is-active {
    background: rgba(255, 255, 255, 0.04);
    color: #eeeeee !important;
  }

  .terminal-tab span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1;
    font-size: 10px;
  }

  .terminal-tab input {
    width: 98px;
    height: 18px;
    border: 0;
    outline: none;
    background: transparent;
    color: #eeeeee;
    font: inherit;
    font-size: 12px;
  }

  .terminal-tab b {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 4px;
    color: rgba(216, 216, 216, 0.42);
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
  }

  .terminal-tab b:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #eeeeee;
  }

  .terminal-actions {
    display: flex;
    align-items: center;
    gap: 1px;
    height: 34px;
  }

  .terminal-actions button {
    width: 26px;
    border-radius: 6px;
    padding: 0;
    color: rgba(216, 216, 216, 0.62) !important;
  }

  .terminal-actions button:disabled {
    cursor: default;
    opacity: 0.34;
  }

  .terminal-new {
    position: relative;
    flex: 0 0 auto;
  }

  .terminal-new-tab {
    width: 28px;
    border-radius: 6px;
  }

  .terminal-shell-menu {
    position: absolute;
    top: calc(100% + 4px);
    min-width: 158px;
    display: grid;
    gap: 3px;
    padding: 6px;
    border: 1px solid #202020;
    border-radius: 8px;
    background: rgba(18, 18, 18, 0.96);
    backdrop-filter: blur(20px) saturate(1.25);
    -webkit-backdrop-filter: blur(20px) saturate(1.25);
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.44);
    z-index: 70;
  }

  .terminal-shell-menu button,
  .terminal-empty button {
    min-height: 28px;
    border-radius: 7px;
    padding: 0 9px;
    color: #d8d8d8;
    font-size: 12px;
    text-align: left;
  }

  .terminal-stage {
    min-width: 0;
    min-height: 0;
    background: #1A1A1A;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .terminal-host {
    width: 100%;
    height: 100%;
    padding: 7px 9px 5px;
    box-sizing: border-box;
  }

  .terminal-empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: rgba(216, 216, 216, 0.42);
    font-size: 12px;
  }

  .terminal-floating .xterm {
    height: 100%;
  }

  .terminal-embedded .terminal-stage {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .terminal-embedded .xterm {
    height: 100%;
  }

  .terminal-floating .xterm-viewport {
    background: #101010 !important;
    scrollbar-width: thin;
    scrollbar-color: #2f2f2f transparent;
  }

  .terminal-floating .xterm-viewport::-webkit-scrollbar {
    width: 6px;
  }

  .terminal-floating .xterm-viewport::-webkit-scrollbar-thumb {
    background: #2f2f2f;
    border-radius: 3px;
  }

  @media (max-width: 720px) {
    .terminal-floating {
      width: calc(100vw - 24px);
    }

    .terminal-tab {
      min-width: 78px;
      max-width: 136px;
    }
  }

  .braille-spinner {
    position: relative;
    color: #f8ead8;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    line-height: 1;
    opacity: 0.78;
    transition: color 620ms ease, text-shadow 620ms ease, opacity 620ms ease;
    text-shadow:
      0 0 10px rgba(248, 234, 216, 0.42),
      0 0 18px rgba(255, 243, 223, 0.2);
  }

  .braille-spinner[data-state="streaming"]::before {
    animation-duration: 520ms;
  }

  .braille-spinner[data-state="tool_call"]::before {
    animation: tool-frame 720ms steps(1, end) infinite;
  }

  .braille-spinner[data-state="approval"]::before {
    animation: approval-pulse 1200ms steps(1, end) infinite;
  }

  .braille-spinner[data-state="running"]::before {
    animation: running-frame 1500ms steps(1, end) infinite;
  }

  .braille-spinner[data-state="streaming"] {
    color: #fff3df;
  }

  .braille-spinner[data-state="tool_call"] {
    color: #fff3df;
  }

  .braille-spinner[data-state="approval"] {
    color: #fff3df;
  }

  .braille-spinner[data-state="running"] {
    color: #fff3df;
  }

  .braille-spinner[data-state="error"] {
    color: #ff7a45;
    text-shadow:
      0 0 10px rgba(255, 122, 69, 0.36),
      0 0 18px rgba(255, 183, 122, 0.2);
  }

  .braille-spinner::before {
    content: "\280b";
    font-size: 18px;
    animation: braille-frame 880ms steps(1, end) infinite;
  }

  .chat-dot::before {
    content: "·";
    color: #777777;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 18px;
    line-height: 1;
  }

  .codeclub-tool-braille {
    display: inline-block;
    min-width: 16px;
    color: #ffffff;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 16px;
    line-height: 1;
    letter-spacing: -0.08em;
    text-align: center;
    transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
  }

  .codeclub-tool-braille[data-state="running"] {
    color: #fff3df;
    text-shadow:
      0 0 8px rgba(248, 234, 216, 0.34),
      0 0 14px rgba(255, 243, 223, 0.18);
    transform: translateY(-0.5px);
  }

  .codeclub-tool-braille[data-state="completed"] {
    color: #1687ff;
    text-shadow:
      0 0 8px rgba(22, 135, 255, 0.36),
      0 0 14px rgba(103, 186, 255, 0.2);
    opacity: 0.9;
  }

  .codeclub-tool-braille[data-state="error"] {
    color: #ff7a45;
    text-shadow:
      0 0 8px rgba(255, 122, 69, 0.36),
      0 0 14px rgba(255, 183, 122, 0.2);
  }

  @keyframes braille-frame {
    0% { content: "\280b"; }
    12.5% { content: "\2819"; }
    25% { content: "\2839"; }
    37.5% { content: "\2838"; }
    50% { content: "\283c"; }
    62.5% { content: "\2834"; }
    75% { content: "\2826"; }
    87.5% { content: "\2827"; }
  }

  @keyframes tool-frame {
    0%, 100% { content: "\280b"; }
    6.25% { content: "\2819"; }
    12.5% { content: "\281a"; }
    18.75% { content: "\2812"; }
    25% { content: "\2802"; }
    31.25% { content: "\2802"; }
    37.5% { content: "\2812"; }
    43.75% { content: "\2832"; }
    50% { content: "\2834"; }
    56.25% { content: "\2826"; }
    62.5% { content: "\2816"; }
    68.75% { content: "\2812"; }
    75% { content: "\2810"; }
    81.25% { content: "\2810"; }
    87.5% { content: "\2812"; }
    93.75% { content: "\2813"; }
  }

  @keyframes running-frame {
    0%, 100% { content: "\280b"; }
    12.5% { content: "\2819"; }
    25% { content: "\2839"; }
    37.5% { content: "\2838"; }
    50% { content: "\283c"; }
    62.5% { content: "\2834"; }
    75% { content: "\2826"; }
    87.5% { content: "\2827"; }
  }

  @keyframes approval-pulse {
    0%, 100% { content: "\283f"; opacity: 0.52; transform: scale(0.86); }
    12.5% { content: "\283e"; }
    25% { content: "\283d"; opacity: 0.78; transform: scale(0.94); }
    37.5% { content: "\283b"; }
    50% { content: "\283f"; opacity: 1; transform: scale(1); }
    62.5% { content: "\2837"; }
    75% { content: "\282f"; opacity: 0.78; transform: scale(0.94); }
    87.5% { content: "\281f"; }
  }

  .messages-area::-webkit-scrollbar {
    width: 6px;
  }
  .messages-area::-webkit-scrollbar-track {
    background: transparent;
  }
  .messages-area::-webkit-scrollbar-thumb {
    background: #2f2f2f;
    border-radius: 3px;
  }
  .messages-area {
    scrollbar-width: thin;
    scrollbar-color: #2f2f2f transparent;
  }

  .messages-area a {
    color: #c2c2c2;
    text-decoration: underline;
    text-decoration-color: rgba(194, 194, 194, 0.55);
    text-underline-offset: 3px;
  }

  .messages-area a:hover {
    color: #d0d0d0;
  }

  .messages-area ul,
  .messages-area ol {
    list-style-position: outside;
    color: #c2c2c2;
  }

  .messages-area ul {
    list-style-type: disc;
  }

  .messages-area ol {
    list-style-type: decimal;
  }

  .messages-area li::marker { color: #4a4a4a; }

  .messages-area blockquote {
    margin: 12px 0;
    padding: 8px 14px;
    border-left: 3px solid #2b2b2b;
    border-radius: 0 7px 7px 0;
    background: #151515;
    color: #c2c2c2;
  }

  .messages-area blockquote p:last-child {
    margin-bottom: 0 !important;
  }

  .messages-area code {
    padding: 2px 5px;
    border: 1px solid #2b2b2b;
    border-radius: 5px;
    background: #181818;
    color: #c2c2c2;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9em;
  }

  .messages-area pre {
    max-width: 100%;
    margin: 12px 0;
    padding: 12px 14px;
    overflow-x: auto;
    border: 1px solid #2b2b2b;
    border-radius: 8px;
    background: #151515;
    color: #d8d8d8;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    line-height: 1.55;
  }

  .messages-area pre code {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .messages-area .hljs-comment,
  .messages-area .hljs-quote {
    color: #7f8c98;
    font-style: italic;
  }

  .messages-area .hljs-keyword,
  .messages-area .hljs-selector-tag,
  .messages-area .hljs-literal,
  .messages-area .hljs-section {
    color: #c792ea;
  }

  .messages-area .hljs-string,
  .messages-area .hljs-attr,
  .messages-area .hljs-template-variable {
    color: #c3e88d;
  }

  .messages-area .hljs-number,
  .messages-area .hljs-variable,
  .messages-area .hljs-regexp {
    color: #f78c6c;
  }

  .messages-area .hljs-title,
  .messages-area .hljs-title.function_,
  .messages-area .hljs-function .hljs-title {
    color: #82aaff;
  }

  .messages-area .hljs-built_in,
  .messages-area .hljs-type,
  .messages-area .hljs-class .hljs-title {
    color: #ffcb6b;
  }

  .messages-area .hljs-meta,
  .messages-area .hljs-symbol {
    color: #89ddff;
  }

  .messages-area hr {
    margin: 16px 0;
    border: 0;
    border-top: 1px solid #3a3a3a;
  }

  .messages-area h4,
  .messages-area h5,
  .messages-area h6 {
    margin: 12px 0 7px;
    color: #eeeeee;
    font-weight: 650;
  }

  .messages-area input[type="checkbox"] {
    accent-color: #c792ea;
  }

</style>
