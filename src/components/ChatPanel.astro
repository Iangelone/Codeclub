---
import ChatInterface from "./ChatInterface.tsx";
import TerminalDock from "./TerminalDock.tsx";
import { models, providers } from "../lib/ai-catalog";

const defaultProvider = providers.length > 0 ? providers[0] : null;
const defaultModel = defaultProvider ? (models.find((model) => model.providerId === defaultProvider.id) ?? models[0]) : null;
const catalog = [
  ...providers.map((provider) => ({ ...provider, type: "provider" })),
  ...models.map((model) => ({ ...model, type: "model" })),
];
---

<section class="chat-panel" aria-label="Chat">
  <ChatInterface client:load catalog={catalog} defaultProvider={defaultProvider} defaultModel={defaultModel} />
  <TerminalDock client:load />
</section>

<style is:global>
  .chat-panel {
    position: relative;
    min-width: 0;
    min-height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .terminal-dock {
    position: absolute;
    left: 50%;
    bottom: max(82px, calc((100% - min(720px, calc(100vh - 96px))) / 2 + 82px));
    width: min(760px, calc(100% - 64px));
    height: clamp(220px, 36vh, 360px);
    display: grid;
    grid-template-rows: minmax(0, 1fr) 34px;
    border: 1px solid var(--color-surface-10, #2f2f2f);
    border-radius: 11px;
    background: rgba(16, 16, 16, 0.96);
    box-shadow:
      0 22px 70px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.018),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
    z-index: 38;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 18px) scale(0.985);
    transform-origin: 50% 100%;
    transition:
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .terminal-dock.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
  }

  .terminal-dock-bar {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    border-top: 1px solid var(--color-surface-10, #2f2f2f);
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background: rgba(22, 22, 22, 0.82);
    backdrop-filter: blur(20px) saturate(1.28);
    -webkit-backdrop-filter: blur(20px) saturate(1.28);
    position: relative;
    z-index: 5;
  }

  .terminal-dock button {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    color: #d8d8d8;
    font: inherit;
  }

  .terminal-tab,
  .terminal-new-tab,
  .terminal-actions button {
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(216, 216, 216, 0.62) !important;
    font-size: 12px;
    line-height: 1;
  }

  .terminal-tab:hover:not(.is-active),
  .terminal-new-tab:hover,
  .terminal-actions button:hover:not(:disabled),
  .terminal-shell-menu button:hover,
  .terminal-empty button:hover {
    background: rgba(255, 255, 255, 0.055);
    color: #eeeeee;
  }

  .terminal-tabs {
    min-width: 0;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    height: 34px;
    padding-top: 4px;
  }

  .terminal-tabs::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .terminal-tab {
    flex: 0 0 auto;
    min-width: 92px;
    max-width: 174px;
    gap: 6px;
    padding: 0 7px 0 10px;
    border: 1px solid rgba(255, 255, 255, 0.045) !important;
    border-bottom-color: transparent !important;
    border-radius: 8px 8px 0 0;
    background: rgba(255, 255, 255, 0.025);
    transform: translateY(1px);
  }

  .terminal-tab.is-active {
    background: #101010;
    border-color: var(--color-surface-10, #2f2f2f) !important;
    border-bottom-color: #101010 !important;
    color: #eeeeee !important;
    transform: translateY(0);
  }

  .terminal-tab span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1;
  }

  .terminal-tab input {
    width: 98px;
    height: 18px;
    border: 0;
    outline: none;
    background: transparent;
    color: #eeeeee;
    font: inherit;
    font-size: 12px;
  }

  .terminal-tab b {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 4px;
    color: rgba(216, 216, 216, 0.42);
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
  }

  .terminal-tab b:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #eeeeee;
  }

  .terminal-actions {
    display: flex;
    align-items: center;
    gap: 1px;
    height: 34px;
  }

  .terminal-actions button {
    width: 26px;
    border-radius: 6px;
    padding: 0;
    color: rgba(216, 216, 216, 0.62) !important;
  }

  .terminal-actions button:disabled {
    cursor: default;
    opacity: 0.34;
  }

  .terminal-new {
    position: relative;
    flex: 0 0 auto;
  }

  .terminal-new-tab {
    width: 28px;
    border-radius: 7px 7px 0 0;
    transform: translateY(1px);
  }

  .terminal-shell-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    min-width: 158px;
    display: grid;
    gap: 3px;
    padding: 6px;
    border: 1px solid var(--color-surface-10, #2f2f2f);
    border-radius: 8px;
    background: rgba(18, 18, 18, 0.96);
    backdrop-filter: blur(20px) saturate(1.25);
    -webkit-backdrop-filter: blur(20px) saturate(1.25);
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.44);
    z-index: 70;
  }

  .terminal-shell-menu button,
  .terminal-empty button {
    min-height: 28px;
    border-radius: 7px;
    padding: 0 9px;
    color: #d8d8d8;
    font-size: 12px;
    text-align: left;
  }

  .terminal-stage {
    min-width: 0;
    min-height: 0;
    background: #101010;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .terminal-host {
    width: 100%;
    height: 100%;
    padding: 7px 9px 5px;
    box-sizing: border-box;
  }

  .terminal-empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: rgba(216, 216, 216, 0.42);
    font-size: 12px;
  }

  .terminal-dock .xterm {
    height: 100%;
  }

  .terminal-dock .xterm-viewport {
    background: #101010 !important;
    scrollbar-width: thin;
    scrollbar-color: #2f2f2f transparent;
  }

  .terminal-dock .xterm-viewport::-webkit-scrollbar {
    width: 6px;
  }

  .terminal-dock .xterm-viewport::-webkit-scrollbar-thumb {
    background: #2f2f2f;
    border-radius: 3px;
  }

  @media (max-width: 720px) {
    .terminal-dock {
      bottom: 78px;
      width: calc(100% - 24px);
      height: min(320px, 42vh);
    }

    .terminal-tab {
      min-width: 78px;
      max-width: 136px;
    }
  }

  @media (max-height: 620px) {
    .terminal-dock {
      bottom: 72px;
      height: min(240px, 40vh);
    }
  }

  .braille-spinner {
    position: relative;
    color: #c7cbff;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    line-height: 1;
    opacity: 0.78;
    transition: color 620ms ease, text-shadow 620ms ease, opacity 620ms ease;
    text-shadow:
      0 0 10px rgba(123, 130, 255, 0.42),
      0 0 18px rgba(255, 117, 181, 0.18);
  }

  .braille-spinner[data-state="idle"] {
    animation: spinner-idle-color 5.6s ease-in-out infinite;
  }

  .braille-spinner[data-state="streaming"] {
    color: #7dd3fc;
    text-shadow:
      0 0 10px rgba(125, 211, 252, 0.42),
      0 0 18px rgba(103, 232, 249, 0.18);
  }

  .braille-spinner[data-state="tool_call"] {
    color: #86efac;
    text-shadow:
      0 0 10px rgba(134, 239, 172, 0.36),
      0 0 18px rgba(45, 212, 191, 0.16);
  }

  .braille-spinner[data-state="approval"] {
    color: #fde68a;
    text-shadow:
      0 0 10px rgba(253, 230, 138, 0.34),
      0 0 18px rgba(251, 191, 36, 0.14);
  }

  .braille-spinner[data-state="running"] {
    color: #d8b4fe;
    text-shadow:
      0 0 10px rgba(216, 180, 254, 0.38),
      0 0 18px rgba(168, 85, 247, 0.16);
  }

  .braille-spinner[data-state="error"] {
    color: #fca5a5;
    text-shadow:
      0 0 10px rgba(252, 165, 165, 0.34),
      0 0 18px rgba(248, 113, 113, 0.14);
  }

  .braille-spinner::before {
    content: "\280b";
    font-size: 18px;
    animation: braille-frame 880ms steps(1, end) infinite;
  }

  @keyframes braille-frame {
    0% { content: "\280b"; }
    12.5% { content: "\2819"; }
    25% { content: "\2839"; }
    37.5% { content: "\2838"; }
    50% { content: "\283c"; }
    62.5% { content: "\2834"; }
    75% { content: "\2826"; }
    87.5% { content: "\2827"; }
  }

  .messages-area::-webkit-scrollbar {
    width: 6px;
  }
  .messages-area::-webkit-scrollbar-track {
    background: transparent;
  }
  .messages-area::-webkit-scrollbar-thumb {
    background: #2f2f2f;
    border-radius: 3px;
  }
  .messages-area {
    scrollbar-width: thin;
    scrollbar-color: #2f2f2f transparent;
  }

  @keyframes spinner-idle-color {
    0%, 100% {
      color: #c7cbff;
      text-shadow:
        0 0 10px rgba(123, 130, 255, 0.42),
        0 0 18px rgba(255, 117, 181, 0.18);
    }
    16% {
      color: #7dd3fc;
      text-shadow:
        0 0 10px rgba(125, 211, 252, 0.38),
        0 0 18px rgba(103, 232, 249, 0.16);
    }
    32% {
      color: #86efac;
      text-shadow:
        0 0 10px rgba(134, 239, 172, 0.32),
        0 0 18px rgba(45, 212, 191, 0.14);
    }
    48% {
      color: #fde68a;
      text-shadow:
        0 0 10px rgba(253, 230, 138, 0.28),
        0 0 18px rgba(251, 191, 36, 0.12);
    }
    64% {
      color: #f9a8d4;
      text-shadow:
        0 0 10px rgba(249, 168, 212, 0.32),
        0 0 18px rgba(244, 114, 182, 0.14);
    }
    80% {
      color: #d8b4fe;
      text-shadow:
        0 0 10px rgba(216, 180, 254, 0.34),
        0 0 18px rgba(251, 113, 133, 0.14);
    }
  }
</style>
