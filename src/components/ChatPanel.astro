---
import { ArrowUp } from "lucide-astro";
import { models, providers } from "../lib/ai-catalog";

const defaultProvider = providers[0];
const defaultModel = models.find((model) => model.providerId === defaultProvider.id) ?? models[0];
const catalog = [
  ...providers.map((provider) => ({ ...provider, type: "provider" })),
  ...models.map((model) => ({ ...model, type: "model" })),
];
---

<section class="chat-panel" aria-label="Chat" data-provider-id={defaultProvider.id} data-provider={defaultProvider.label} data-model={defaultModel.label}>
  <div class="chat-composer">
    <div class="composer-status">
      <span class="braille-spinner" aria-hidden="true"></span>
      <p>Listo cuando t&uacute; lo est&eacute;s.</p>
    </div>
    <div class="selection-status" aria-live="polite">
      <span data-current-provider>{defaultProvider.label}</span>
      <span data-current-model>{defaultModel.label}</span>
    </div>
    <div class="composer-box">
      <input data-chat-input type="text" placeholder="Pregunt&aacute;, ped&iacute; c&oacute;digo o describ&iacute; una tarea" aria-label="Mensaje" />
      <button class="send-button" type="button" aria-label="Enviar"><ArrowUp size={15} strokeWidth={2} /></button>
    </div>
    <div class="command-menu" data-command-menu>
      <div class="command-title" data-command-title>Seleccionar</div>
      <input data-command-search type="text" placeholder="Buscar proveedor o modelo" aria-label="Buscar proveedor o modelo" />
      <div class="command-list">
        {catalog.map((item) => (
          <button
            type="button"
            data-command-item
            data-kind={item.type}
            data-id={item.id}
            data-label={item.label}
            data-provider={item.type === "model" ? item.providerId : item.id}
          >
            <span>{item.label}</span>
            <small>{item.type === "provider" ? "proveedor" : "modelo"}</small>
          </button>
        ))}
      </div>
    </div>
  </div>

  <script>
    const panel = document.querySelector<HTMLElement>(".chat-panel");
    const chatInput = document.querySelector<HTMLInputElement>("[data-chat-input]");
    const menu = document.querySelector<HTMLElement>("[data-command-menu]");
    const searchInput = document.querySelector<HTMLInputElement>("[data-command-search]");
    const commandTitle = document.querySelector<HTMLElement>("[data-command-title]");
    const providerText = document.querySelector<HTMLElement>("[data-current-provider]");
    const modelText = document.querySelector<HTMLElement>("[data-current-model]");
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-command-item]"));

    let commandKind = "";

    const closeMenu = () => {
      menu?.classList.remove("is-open");
      commandKind = "";
    };

    const openMenu = (kind: string) => {
      commandKind = kind;
      if (commandTitle) commandTitle.textContent = kind === "provider" ? "Proveedores" : "Modelos";
      if (searchInput) searchInput.placeholder = kind === "provider" ? "Buscar proveedor" : "Buscar modelo del proveedor activo";
      menu?.classList.add("is-open");
      if (searchInput) {
        searchInput.value = "";
        searchInput.focus();
      }
      filterItems();
    };

    const filterItems = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      items.forEach((item) => {
        const matchesKind = item.dataset.kind === commandKind;
        const matchesQuery = item.dataset.label?.toLowerCase().includes(query);
        const matchesProvider = commandKind !== "model" || item.dataset.provider === panel?.dataset.providerId;
        item.hidden = !matchesKind || !matchesQuery || !matchesProvider;
      });
    };

    chatInput?.addEventListener("input", () => {
      const value = chatInput.value.toLowerCase();
      if (value.endsWith("/proveedor")) {
        openMenu("provider");
      } else if (value.endsWith("/modelo")) {
        openMenu("model");
      } else {
        closeMenu();
      }
    });

    searchInput?.addEventListener("input", filterItems);
    searchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        chatInput?.focus();
      }
    });

    items.forEach((item) => {
      item.addEventListener("click", () => {
        if (item.dataset.kind === "provider" && providerText && panel) {
          providerText.textContent = item.dataset.label ?? "";
          panel.dataset.providerId = item.dataset.id ?? "";
          panel.dataset.provider = item.dataset.label ?? "";
          const firstModel = items.find((model) => model.dataset.kind === "model" && model.dataset.provider === item.dataset.id);
          if (firstModel && modelText) {
            modelText.textContent = firstModel.dataset.label ?? "";
            panel.dataset.model = firstModel.dataset.label ?? "";
          }
        }
        if (item.dataset.kind === "model" && modelText && panel) {
          modelText.textContent = item.dataset.label ?? "";
          panel.dataset.model = item.dataset.label ?? "";
        }
        if (chatInput) chatInput.value = chatInput.value.replace(/\/(proveedor|modelo)$/i, "").trimStart();
        closeMenu();
        chatInput?.focus();
      });
    });
  </script>
</section>

<style>
  .chat-panel {
    position: relative;
    min-width: 0;
    min-height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .chat-composer {
    position: relative;
    width: min(600px, calc(100% - 64px));
    display: grid;
    gap: 10px;
  }

  .composer-status,
  .selection-status {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .composer-status {
    gap: 8px;
  }

  .composer-status p {
    margin: 0;
    color: rgba(216, 216, 216, 0.82);
    font-size: 16px;
    font-weight: 400;
  }

  .selection-status {
    gap: 8px;
    color: rgba(216, 216, 216, 0.42);
    font-size: 12px;
  }

  .selection-status span + span::before {
    content: "/";
    margin-right: 8px;
    color: rgba(216, 216, 216, 0.24);
  }

  .composer-box {
    min-height: 40px;
    display: grid;
    grid-template-columns: 1fr 28px;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--color-surface-9);
    border-radius: 8px;
    background: rgba(18, 18, 18, 0.96);
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.26);
  }

  .composer-box input,
  .command-menu input {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: #eeeeee;
    font: inherit;
  }

  .composer-box input {
    height: 28px;
    caret-color: #eeeeee;
    font-size: 12px;
    padding: 0 7px;
  }

  .composer-box input::placeholder,
  .command-menu input::placeholder {
    color: #7d7d7d;
  }

  .send-button {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 7px;
    background: var(--color-surface-8);
    color: #ffffff;
  }

  .send-button:hover {
    background: var(--color-surface-7);
  }

  .command-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    display: grid;
    gap: 8px;
    padding: 9px;
    border: 1px solid var(--color-surface-9);
    border-radius: 8px;
    background: rgba(18, 18, 18, 0.98);
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.34);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px) scale(0.98);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .command-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .command-menu input {
    height: 30px;
    padding: 0 8px;
    border-radius: 7px;
    background: var(--color-surface-3);
    font-size: 12px;
  }

  .command-title {
    color: rgba(216, 216, 216, 0.46);
    font-size: 12px;
    padding: 0 2px;
  }

  .command-list {
    display: grid;
    gap: 4px;
    max-height: 120px;
    overflow: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    padding-bottom: 12px;
  }

  .command-list::-webkit-scrollbar {
    display: none;
  }

  .command-list button[hidden] {
    display: none;
  }

  .command-list button {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: rgba(238, 238, 238, 0.78);
    font: inherit;
    font-size: 12px;
    padding: 0 9px;
    text-align: left;
    transition:
      background 120ms ease,
      color 120ms ease;
  }

  .command-list button:hover {
    background: var(--color-surface-7);
    color: #ffffff;
  }

  .command-list small {
    color: rgba(216, 216, 216, 0.36);
    font-size: 11px;
  }

  .braille-spinner {
    position: relative;
    color: #c7cbff;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    line-height: 1;
    opacity: 0.78;
    text-shadow:
      0 0 10px rgba(123, 130, 255, 0.42),
      0 0 18px rgba(255, 117, 181, 0.18);
  }

  .braille-spinner::before {
    content: "\280b";
    font-size: 18px;
    animation: braille-frame 880ms steps(1, end) infinite;
  }

  @keyframes braille-frame {
    0% { content: "\280b"; }
    12.5% { content: "\2819"; }
    25% { content: "\2839"; }
    37.5% { content: "\2838"; }
    50% { content: "\283c"; }
    62.5% { content: "\2834"; }
    75% { content: "\2826"; }
    87.5% { content: "\2827"; }
  }
</style>
