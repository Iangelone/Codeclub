---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Computer Use</title>
    <style>
      :root { background: transparent; }
      * { box-sizing: border-box; }
      html, body { width: 100%; height: 100%; margin: 0; background: transparent; overflow: hidden; }
      .screen-border {
        position: fixed;
        inset: 0 2px 0 -2px;
        pointer-events: none;
        border: 3px solid #3D9BFF;
        box-shadow: inset 0 0 0 1px rgba(139, 199, 255, 0.72), inset 0 0 24px rgba(61, 155, 255, 0.72), 0 0 22px rgba(61, 155, 255, 0.82);
        z-index: 1;
      }
      .pill {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: min(520px, calc(100% - 32px));
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        border: 1px solid rgba(141, 214, 255, 0.72);
        border-radius: 999px;
        background: linear-gradient(105deg, rgba(72, 190, 255, 0.84), rgba(110, 202, 255, 0.76));
        box-shadow: 0 0 28px rgba(61, 155, 255, 0.9), 0 0 58px rgba(61, 155, 255, 0.32), 0 8px 26px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.42);
        color: #f7fcff;
        font: 600 13px/1.1 "Segoe UI", sans-serif;
        text-shadow: 0 1px 2px rgba(0, 50, 90, 0.32);
        white-space: nowrap;
        z-index: 2;
      }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 8px #fff; }
      .separator { opacity: 0.68; }
      .cancel { font-weight: 700; }
      .cursor {
        position: absolute;
        top: 0;
        left: 0;
        width: 25px;
        height: 29px;
        pointer-events: none;
        filter: drop-shadow(0 0 8px rgba(61, 155, 255, 0.95)) drop-shadow(0 3px 5px rgba(0, 0, 0, 0.42));
        transform: translate(-100px, -100px);
        transition: transform 45ms linear;
        z-index: 3;
      }
      .cursor img { display: block; width: 100%; height: 100%; object-fit: contain; image-rendering: auto; }
    </style>
  </head>
  <body>
    <div class="screen-border" aria-hidden="true"></div>
    <div class="pill" role="status" aria-label="Codeclub is using your computer. Press Escape to cancel.">
      <span class="dot" aria-hidden="true"></span>
      <span><strong id="computer-provider">Codeclub</strong> is using your computer</span>
      <span class="separator">·</span>
      <span class="cancel">Esc to cancel</span>
    </div>
    <div class="cursor" id="computer-cursor" aria-hidden="true">
      <img src="/cursors/dark/arrow.png" alt="" draggable="false" />
    </div>
    <script>
      import { listen } from '@tauri-apps/api/event';
      const cursor = document.querySelector('#computer-cursor');
      const provider = document.querySelector('#computer-provider');
      if (provider) {
        listen('codeclub-computer-provider', (event) => {
          const name = typeof event.payload === 'string' && event.payload.trim() ? event.payload.trim() : 'Codeclub';
          provider.textContent = name;
          document.querySelector('.pill')?.setAttribute('aria-label', `${name} is using your computer. Press Escape to cancel.`);
        });
      }
      if (cursor) {
        listen('codeclub-computer-cursor', (event) => {
          const point = event.payload;
          if (point && typeof point.x === 'number' && typeof point.y === 'number') {
            const scale = window.devicePixelRatio || 1;
            cursor.style.transform = `translate(${point.x / scale}px, ${point.y / scale}px)`;
          }
        });
      }
    </script>
  </body>
</html>
