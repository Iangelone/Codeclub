---
import "../styles/global.css";
import Topbar from "../components/Topbar.astro";
import Sidebar from "../components/Sidebar.tsx";
import RightSidebar from "../components/RightSidebar.tsx";
import ChatPanel from "../components/ChatPanel.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Codeclub</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script>
      if (navigator.userAgent.includes("Windows")) {
        document.documentElement.classList.add("is-windows");
      }
    </script>
    <script>
      if (typeof process === 'undefined') {
        window.process = { env: {}, cwd: () => '/', nextTick: (fn, ...a) => setTimeout(fn, 0, ...a), platform: 'browser', argv: [], version: '', browser: true };
      }
    </script>
  </head>
  <body class="has-sidebar group relative isolate grid h-screen max-h-screen grid-rows-[36px_minmax(0,1fr)] grid-cols-[0_minmax(0,1fr)_0] transition-[grid-template-columns] duration-140 ease-out [&.has-sidebar]:grid-cols-[264px_minmax(0,1fr)_0] [&.has-right-panel]:grid-cols-[264px_minmax(0,1fr)_264px] m-0 min-w-[320px] min-h-0 bg-[#111111] text-[#dedede] overflow-hidden font-sans">
    <div id="app-background" aria-hidden="true"></div>
    <Topbar />
    <Sidebar client:load />
    <main class="workspace-shell row-start-2 col-start-2 h-full min-w-0 min-h-0 bg-[#1E1E1E]" aria-label="Workspace">
      <ChatPanel />
    </main>
    <RightSidebar client:load />
    <script>
      const initCodeclubApp = async () => {
        const { getCurrentWindow } = await import('@tauri-apps/api/window');
        const appWindow = getCurrentWindow();
        
        document.querySelector('#minimize')?.addEventListener('click', () => { appWindow.minimize(); });
        document.querySelector('#maximize')?.addEventListener('click', () => { appWindow.toggleMaximize(); });
        document.querySelector('#close')?.addEventListener('click', () => { appWindow.close(); });
        document.querySelector('.drag-area')?.addEventListener('dblclick', () => { appWindow.toggleMaximize(); });
        const toggleFullscreen = async (event) => {
          if (event?.type === 'keydown' && event.key !== 'F11') return;
          event?.preventDefault();
          await appWindow.setSimpleFullscreen(!(await appWindow.isFullscreen()));
        };
        document.addEventListener('keydown', toggleFullscreen);
        document.querySelectorAll('[data-action="toggle-fullscreen"]').forEach((element) => element.addEventListener('click', toggleFullscreen));
        document.querySelectorAll('[data-action="open-settings"]').forEach((element) => element.addEventListener('click', (event) => {
          event.preventDefault();
          window.dispatchEvent(new CustomEvent('codeclub:open-settings'));
        }));
        const menuActions = {
          'new-chat': 'codeclub:request-new-chat',
          'open-projects': 'codeclub:open-projects',
          'open-agent': 'codeclub:open-agent',
          'open-extensions': 'codeclub:open-extensions',
        };
        Object.entries(menuActions).forEach(([action, eventName]) => {
          document.querySelectorAll(`[data-action="${action}"]`).forEach((element) => element.addEventListener('click', (event) => {
            event.preventDefault();
            window.dispatchEvent(new CustomEvent(eventName));
          }));
        });

        const navigationEvents = {
          'codeclub:open-empty-chat': 'chat',
          'codeclub:open-chat': 'chat',
          'codeclub:open-projects': 'projects',
          'codeclub:open-agent': 'agent',
          'codeclub:open-extensions': 'extensions',
          'codeclub:open-settings': 'settings',
        };
        const navigationHistory = ['chat'];
        let navigationIndex = 0;
        const backButton = document.querySelector('#navigate-back');
        const forwardButton = document.querySelector('#navigate-forward');
        const updateNavigationButtons = () => {
          const canGoBack = navigationIndex > 0;
          const canGoForward = navigationIndex < navigationHistory.length - 1;
          backButton?.toggleAttribute('disabled', !canGoBack);
          forwardButton?.toggleAttribute('disabled', !canGoForward);
          backButton?.classList.toggle('opacity-35', !canGoBack);
          forwardButton?.classList.toggle('opacity-35', !canGoForward);
        };
        const openNavigationRoute = (route, historyNavigation = false) => {
          const eventName = Object.entries(navigationEvents).find(([, value]) => value === route)?.[0];
          if (eventName) window.dispatchEvent(new CustomEvent(eventName, { detail: { historyNavigation } }));
        };
        Object.entries(navigationEvents).forEach(([eventName, route]) => {
          window.addEventListener(eventName, (event) => {
            if ((event as CustomEvent).detail?.historyNavigation) return;
            if (navigationHistory[navigationIndex] === route) return;
            navigationHistory.splice(navigationIndex + 1);
            navigationHistory.push(route);
            navigationIndex = navigationHistory.length - 1;
            updateNavigationButtons();
          });
        });
        backButton?.addEventListener('click', () => {
          if (navigationIndex === 0) return;
          navigationIndex -= 1;
          updateNavigationButtons();
          openNavigationRoute(navigationHistory[navigationIndex], true);
        });
        forwardButton?.addEventListener('click', () => {
          if (navigationIndex >= navigationHistory.length - 1) return;
          navigationIndex += 1;
          updateNavigationButtons();
          openNavigationRoute(navigationHistory[navigationIndex], true);
        });
        updateNavigationButtons();

        const recentChatsContainer = document.querySelector('[data-recent-chats]');
        const recentChatList = document.querySelector('[data-recent-chat-list]');
        const recentChatGradient = 'linear-gradient(145deg, #8BC7FF 0%, #3D9BFF 44%, #1687FF 100%)';
        let recentChats = [];
        const renderRecentChats = (chats = []) => {
          if (!recentChatsContainer || !recentChatList) return;
          recentChats = chats;
          recentChatList.replaceChildren();
          recentChatsContainer.classList.toggle('hidden', chats.length === 0);
          chats.forEach((chat) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'flex min-h-[30px] w-full min-w-0 items-center gap-[9px] overflow-hidden rounded-md px-[10px] text-left text-xs text-[#bdbdbd] hover:bg-[var(--color-surface-7)] hover:text-white';
            button.style.textOverflow = 'ellipsis';
            button.style.whiteSpace = 'nowrap';
            const words = String(chat.name || 'Chat').trim().split(/\s+/).filter(Boolean);
            const avatar = document.createElement('span');
            avatar.className = 'grid h-5 w-5 shrink-0 place-items-center rounded-[6px] text-[8px] font-medium uppercase';
            avatar.style.background = recentChatGradient;
            avatar.style.color = '#ffffff';
            avatar.textContent = (String(chat.name || 'Chat').trim().charAt(0) || 'C').toUpperCase();
            const label = document.createElement('span');
            label.className = 'min-w-0 truncate';
            label.textContent = `${words.slice(0, 3).join(' ')}${words.length > 3 ? '...' : ''}`;
            button.append(avatar, label);
            button.title = chat.projectName || 'Sin proyecto';
            button.addEventListener('click', (event) => {
              event.preventDefault();
              window.dispatchEvent(new CustomEvent('codeclub:open-recent-chat', { detail: chat }));
            });
            recentChatList.appendChild(button);
          });
        };
        window.addEventListener('codeclub:recent-chats-changed', (event) => renderRecentChats(event.detail?.chats || []));
        
        let hasProjectSelection = false;
        const projectRequiredControls = document.querySelectorAll('[data-project-required]');
        const updateProjectContext = (enabled) => {
          hasProjectSelection = enabled;
          projectRequiredControls.forEach((control) => {
            const element = control;
            if ('disabled' in element) element.disabled = !enabled;
            element.setAttribute('aria-disabled', String(!enabled));
            element.classList.toggle('opacity-35', !enabled);
            element.classList.toggle('cursor-not-allowed', !enabled);
            element.classList.toggle('pointer-events-none', !enabled && element.tagName !== 'BUTTON');
          });
        };

        window.addEventListener('codeclub:project-selection-changed', (event) => {
          updateProjectContext(event.detail?.selected === true);
        });
        updateProjectContext(false);

        const setProjectsView = (enabled) => document.body.classList.toggle('projects-view', enabled);
        window.addEventListener('codeclub:open-projects', () => setProjectsView(true));
        window.addEventListener('codeclub:open-agent', () => setProjectsView(false));
        window.addEventListener('codeclub:open-chat', () => setProjectsView(false));
        window.addEventListener('codeclub:request-new-chat', () => setProjectsView(false));

        document.querySelectorAll('[data-action="toggle-sidebar"]').forEach((sidebarButton) => sidebarButton.addEventListener('click', (event) => {
          event.preventDefault();
          setProjectsView(false);
          document.body.classList.toggle('has-sidebar');
          document.body.style.setProperty('--left-panel-width', document.body.classList.contains('has-sidebar') ? '264px' : '0px');
        }));

        const singlePanelButton = document.querySelector('#panel-single');
        const splitPanelButton = document.querySelector('#panel-split');
        const dockButton = document.querySelector('#panel-dock');
        const setRightPanel = (open) => {
          document.body.classList.toggle('has-right-panel', open);
          document.body.style.setProperty('--left-panel-width', document.body.classList.contains('has-sidebar') ? '264px' : '0px');
          singlePanelButton?.classList.toggle('is-active', !open);
          splitPanelButton?.classList.toggle('is-active', open);
          window.dispatchEvent(new CustomEvent('codeclub:right-panel-toggled', { detail: { open } }));
        };
        window.addEventListener('codeclub:open-right-panel', () => setRightPanel(true));
        singlePanelButton?.addEventListener('click', () => setRightPanel(false));
        splitPanelButton?.addEventListener('click', () => setRightPanel(!document.body.classList.contains('has-right-panel')));
        dockButton?.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('codeclub:toggle-panel-dock'));
          dockButton.classList.toggle('is-active');
          dockButton.setAttribute('aria-label', dockButton.classList.contains('is-active') ? 'Ocultar dock' : 'Mostrar dock');
          dockButton.setAttribute('title', dockButton.classList.contains('is-active') ? 'Ocultar dock' : 'Mostrar dock');
        });
        setRightPanel(false);
      };
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCodeclubApp, { once: true });
      } else {
        initCodeclubApp();
      }
    </script>
  </body>
</html>

<style is="global">
  body.has-right-panel {
    grid-template-columns: var(--left-panel-width, 264px) minmax(0, 1fr) var(--right-panel-width, 35vw) !important;
  }
</style>
