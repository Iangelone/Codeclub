---
import {
  ArrowLeft,
  ArrowRight,
  Bug,
  FolderPlus,
  Command,
  Eye,
  FilePlus,
  Folder,
  FolderOpen,
  HelpCircle,
  Keyboard,
  LayoutDashboard,
  Minus,
  Package,
  PiggyBank,
  PanelLeft,
  Search,
  Save,
  Scissors,
  Settings,
  Square,
  Terminal,
  Undo2,
  X,
} from "lucide-astro";
import ChatPanel from "../components/ChatPanel.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>Codeclub Desktop</title>
    <script>
      if (navigator.userAgent.includes("Windows")) {
        document.documentElement.classList.add("is-windows");
      }
    </script>
  </head>
  <body class="has-sidebar">
    <header class="topbar">
      <div class="topbar-left">
        <button class="tool-button" type="button" aria-label="Toggle sidebar">
          <PanelLeft size={15} strokeWidth={1.8} />
        </button>
        <button class="tool-button" type="button" aria-label="Back">
          <ArrowLeft size={15} strokeWidth={1.8} />
        </button>
        <button class="tool-button" type="button" aria-label="Forward">
          <ArrowRight size={15} strokeWidth={1.8} />
        </button>
        <nav class="app-menu" aria-label="Application menu">
          <div class="menu-group">
            <button type="button">Archivo</button>
            <div class="dropdown-menu">
              <a href="#"><FilePlus size={14} /> Nuevo archivo</a>
              <a href="#"><FolderOpen size={14} /> Abrir carpeta</a>
              <a href="#"><Save size={14} /> Guardar</a>
              <a href="#"><Command size={14} /> Exportar</a>
            </div>
          </div>
          <div class="menu-group">
            <button type="button">Editar</button>
            <div class="dropdown-menu">
              <a href="#"><Undo2 size={14} /> Deshacer</a>
              <a href="#"><ArrowRight size={14} /> Rehacer</a>
              <a href="#"><Scissors size={14} /> Cortar</a>
              <a href="#"><Settings size={14} /> Preferencias</a>
            </div>
          </div>
          <div class="menu-group">
            <button type="button">Ver</button>
            <div class="dropdown-menu">
              <a href="#"><PanelLeft size={14} /> Panel lateral</a>
              <a href="#"><Terminal size={14} /> Terminal</a>
              <a href="#"><Square size={14} /> Pantalla completa</a>
              <a href="#"><Eye size={14} /> Apariencia</a>
            </div>
          </div>
          <div class="menu-group help-group">
            <button type="button">Ayuda</button>
            <div class="dropdown-menu">
              <a href="#"><HelpCircle size={14} /> Documentación</a>
              <a href="#"><Keyboard size={14} /> Atajos</a>
              <a href="#"><Bug size={14} /> Reportar problema</a>
              <a href="https://ko-fi.com/codeclubide" target="_blank" rel="noreferrer">
                <PiggyBank size={14} /> Donación
              </a>
            </div>
          </div>
        </nav>
      </div>
      <div class="drag-area" data-tauri-drag-region></div>
      <nav class="window-controls" aria-label="Window controls">
        <button id="minimize" type="button" aria-label="Minimize">
          <Minus size={14} strokeWidth={1.8} />
        </button>
        <button id="maximize" type="button" aria-label="Maximize">
          <Square size={12} strokeWidth={1.8} />
        </button>
        <button id="close" class="close" type="button" aria-label="Close">
          <X size={14} strokeWidth={1.8} />
        </button>
      </nav>
    </header>
    <aside class="left-panel" aria-label="Sidebar">
      <section class="panel-actions">
        <div class="sidebar-label"><LayoutDashboard size={14} /> Espacio de trabajo</div>
        <button type="button">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"></path>
            <path d="M19 3v6"></path>
            <path d="M16 6h6"></path>
          </svg>
          Nuevo chat
        </button>
        <button type="button"><Search size={15} /> Buscar</button>
        <button type="button"><Package size={15} /> Complementos</button>
      </section>
      <section class="projects-section">
        <div class="section-heading">
          <span class="heading-title"><Folder size={14} /> Proyectos</span>
          <button id="create-project" type="button" aria-label="Crear proyecto"><FolderPlus size={14} /></button>
        </div>
        <div class="projects-list" aria-label="Lista de proyectos"></div>
      </section>
      <section class="sidebar-footer">
        <button type="button"><Settings size={15} /> Ajustes</button>
      </section>
    </aside>
    <main class="workspace" aria-label="Workspace">
      <ChatPanel />
    </main>

    <script>
      import { getCurrentWindow } from "@tauri-apps/api/window";

      const appWindow = getCurrentWindow();
      const sidebarButton = document.querySelector('[aria-label="Toggle sidebar"]');
      const leftPanel = document.querySelector(".left-panel");
      const createProject = document.querySelector("#create-project");
      const projectsList = document.querySelector(".projects-list");

      const renameProject = (projectRow, projectName) => {
        if (projectRow.querySelector(".project-input")) return;

        const previousName = projectName.textContent ?? "";
        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.value = previousName;
        projectName.replaceWith(input);
        input.focus();
        input.select();
        let isDone = false;

        const finish = () => {
          if (isDone) return;
          isDone = true;
          const nextName = input.value.trim();
          projectName.textContent = nextName || previousName;
          input.replaceWith(projectName);
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (isDone) return;
            isDone = true;
            projectName.textContent = previousName;
            input.replaceWith(projectName);
          }
          if (event.key === "Enter") finish();
        });

        input.addEventListener("blur", finish);
      };

      if (document.body.classList.contains("has-sidebar")) {
        leftPanel?.classList.add("is-open");
      }

      sidebarButton?.addEventListener("click", () => {
        document.body.classList.toggle("has-sidebar");
        leftPanel?.classList.toggle("is-open");
      });

      createProject?.addEventListener("click", () => {
        if (projectsList?.querySelector(".project-input")) return;

        const draft = document.createElement("div");
        draft.className = "project-input-row";
        draft.innerHTML =
          '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>';

        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.placeholder = "Nombre del proyecto";
        draft.append(input);
        projectsList?.prepend(draft);
        input.focus();

        const cancel = () => draft.remove();

        const create = async () => {
          const name = input.value.trim();
          if (!name) {
            cancel();
            return;
          }

          try {
            const { open } = await import('@tauri-apps/plugin-dialog');
            const { mkdir, exists, BaseDirectory, writeTextFile, readTextFile } = await import('@tauri-apps/plugin-fs');
            
            const selectedPath = await open({
              directory: true,
              multiple: false,
              title: "Seleccionar carpeta para el proyecto",
            });

            if (!selectedPath) {
              cancel();
              return;
            }

            // Create .codeclub directory inside the selected project
            const codeclubPath = `${selectedPath}/.codeclub`;
            const hasCodeclub = await exists(codeclubPath);
            if (!hasCodeclub) {
              await mkdir(codeclubPath);
              await mkdir(`${codeclubPath}/chats`);
              await writeTextFile(`${codeclubPath}/meta.json`, JSON.stringify({ name, path: selectedPath, created_at: new Date().toISOString(), chats: [] }));
            }

            // Save to global projects list via FS BaseDirectory
            const appDataPath = 'projects.json';
            let globalProjects = [];
            try {
              const { readTextFile, writeTextFile, mkdir, exists, BaseDirectory } = await import('@tauri-apps/plugin-fs');
              
              if (await exists(appDataPath, { baseDir: BaseDirectory.AppLocalData })) {
                const data = await readTextFile(appDataPath, { baseDir: BaseDirectory.AppLocalData });
                if (data) globalProjects = JSON.parse(data);
              }
              
              if (!globalProjects.find(p => p.path === selectedPath)) {
                globalProjects.push({ name, path: selectedPath });
                if (!(await exists('', { baseDir: BaseDirectory.AppLocalData }))) {
                  await mkdir('', { baseDir: BaseDirectory.AppLocalData, recursive: true });
                }
                await writeTextFile(appDataPath, JSON.stringify(globalProjects), { baseDir: BaseDirectory.AppLocalData });
              }
            } catch(e) { console.error("Error saving global projects", e); }

            const project = document.createElement("div");
            project.className = "project-card";
            project.dataset.path = selectedPath;

            const projectRow = document.createElement("button");
            projectRow.className = "project-row";
            projectRow.type = "button";
            projectRow.innerHTML =
              '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
            const projectNameSpan = document.createElement("span");
            projectNameSpan.textContent = name;
            projectNameSpan.style.flex = "1"; // take remaining space
            
            const newChatBtn = document.createElement("div");
            newChatBtn.className = "project-new-chat-btn";
            newChatBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>';
            
            projectRow.append(projectNameSpan, newChatBtn);
            projectRow.addEventListener("click", (e) => {
              if (e.target.closest('.project-new-chat-btn')) return;
              project.classList.toggle("is-active");
            });
            projectRow.addEventListener("dblclick", () => {
              renameProject(projectRow, projectNameSpan);
            });

            const chatRow = document.createElement("button");
            chatRow.className = "chat-row";
            chatRow.type = "button";
            chatRow.innerHTML =
              '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg><span>Crear chat</span>';
            
            const createChatLogic = async () => {
              const chatId = Date.now().toString();
              
              try {
                const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
                const metaPath = `${selectedPath}/.codeclub/meta.json`;
                if (await exists(metaPath)) {
                  const metaContent = await readTextFile(metaPath);
                  const metaData = JSON.parse(metaContent);
                  if (!metaData.chats) metaData.chats = [];
                  metaData.chats.push({ id: chatId, name: 'Nuevo chat' });
                  await writeTextFile(metaPath, JSON.stringify(metaData));
                }
              } catch(e) { console.error("Error saving chat meta", e); }

              const newChat = document.createElement("button");
              newChat.className = "chat-row chat-item";
              newChat.type = "button";
              newChat.dataset.chatId = chatId;
              newChat.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span class="chat-title">Nuevo chat</span>';
              
              newChat.addEventListener("click", () => {
                window.dispatchEvent(new CustomEvent('codeclub:open-chat', { detail: { projectPath: selectedPath, chatId } }));
                projectsList?.querySelectorAll(".chat-row").forEach(c => c.classList.remove("is-active"));
                newChat.classList.add("is-active");
              });

              project.insertBefore(newChat, chatRow);
              project.classList.add("is-active"); // Ensure project opens
              newChat.click();
            };
            
            chatRow.addEventListener("click", createChatLogic);
            newChatBtn.addEventListener("click", createChatLogic);

            project.append(projectRow, chatRow);
            project.classList.add("is-active");
            draft.replaceWith(project);
          } catch(err) {
            console.error(err);
            cancel();
          }
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") cancel();
          if (event.key === "Enter") create();
        });
      });

      document.querySelector("#minimize")?.addEventListener("click", () => {
        appWindow.minimize();
      });

      document.querySelector("#maximize")?.addEventListener("click", () => {
        appWindow.toggleMaximize();
      });

      document.querySelector("#close")?.addEventListener("click", () => {
        appWindow.close();
      });

      window.addEventListener("codeclub:require-project", () => {
        const createBtn = document.querySelector("#create-project");
        if (createBtn) createBtn.click();
      });

      // Load existing projects on startup
      const loadProjects = async () => {
        try {
          const { exists, readTextFile, BaseDirectory } = await import('@tauri-apps/plugin-fs');
          const appDataPath = 'projects.json';
          
          if (await exists(appDataPath, { baseDir: BaseDirectory.AppLocalData })) {
            const data = await readTextFile(appDataPath, { baseDir: BaseDirectory.AppLocalData });
            if (data) {
              const globalProjects = JSON.parse(data);
            
            for (const proj of globalProjects) {
              const project = document.createElement("div");
              project.className = "project-card";
              project.dataset.path = proj.path;

              const projectRow = document.createElement("button");
              projectRow.className = "project-row";
              projectRow.type = "button";
              projectRow.innerHTML =
                '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
              let projectChats = [];
              try {
                const metaPath = `${proj.path}/.codeclub/meta.json`;
                if (await exists(metaPath)) {
                  const metaContent = await readTextFile(metaPath);
                  const metaData = JSON.parse(metaContent);
                  if (metaData.chats) projectChats = metaData.chats;
                }
              } catch(e) { console.error("Error reading meta for", proj.name, e); }

              const projectNameSpan = document.createElement("span");
              projectNameSpan.textContent = proj.name;
              projectNameSpan.style.flex = "1";
              
              const newChatBtn = document.createElement("div");
              newChatBtn.className = "project-new-chat-btn";
              newChatBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>';
              
              projectRow.append(projectNameSpan, newChatBtn);
              
              projectRow.addEventListener("click", (e) => {
                if (e.target.closest('.project-new-chat-btn')) return;
                project.classList.toggle("is-active");
              });
              
              projectRow.addEventListener("dblclick", () => {
                renameProject(projectRow, projectNameSpan);
              });

              const chatRow = document.createElement("button");
              chatRow.className = "chat-row";
              chatRow.type = "button";
              chatRow.innerHTML =
                '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg><span>Crear chat</span>';

              const createChatLogic = async () => {
                const chatId = Date.now().toString();
                
                try {
                  const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
                  const metaPath = `${proj.path}/.codeclub/meta.json`;
                  if (await exists(metaPath)) {
                    const metaContent = await readTextFile(metaPath);
                    const metaData = JSON.parse(metaContent);
                    if (!metaData.chats) metaData.chats = [];
                    metaData.chats.push({ id: chatId, name: 'Nuevo chat' });
                    await writeTextFile(metaPath, JSON.stringify(metaData));
                  }
                } catch(e) { console.error("Error saving chat meta", e); }

                const newChat = document.createElement("button");
                newChat.className = "chat-row chat-item";
                newChat.type = "button";
                newChat.dataset.chatId = chatId;
                newChat.innerHTML = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span class="chat-title">Nuevo chat</span>`;
                
                newChat.addEventListener("click", () => {
                  window.dispatchEvent(new CustomEvent('codeclub:open-chat', { detail: { projectPath: proj.path, chatId } }));
                  projectsList?.querySelectorAll(".chat-row").forEach(c => c.classList.remove("is-active"));
                  newChat.classList.add("is-active");
                });

                project.insertBefore(newChat, chatRow);
                project.classList.add("is-active");
                newChat.click();
              };
              
              chatRow.addEventListener("click", createChatLogic);
              newChatBtn.addEventListener("click", createChatLogic);
              
              projectChats.forEach(chat => {
                const existingChat = document.createElement("button");
                existingChat.className = "chat-row chat-item";
                existingChat.type = "button";
                existingChat.dataset.chatId = chat.id;
                existingChat.innerHTML = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span class="chat-title">${chat.name || 'Nuevo chat'}</span>`;
                
                existingChat.addEventListener("click", () => {
                  window.dispatchEvent(new CustomEvent('codeclub:open-chat', { detail: { projectPath: proj.path, chatId: chat.id } }));
                  projectsList?.querySelectorAll(".chat-row").forEach(c => c.classList.remove("is-active"));
                  existingChat.classList.add("is-active");
                });
                project.append(existingChat);
              });

              project.append(chatRow);
              projectsList?.append(project);
            }
          }
        }
      } catch(e) {
        console.error("Error loading projects on startup", e);
      }
    };

      loadProjects();

      window.addEventListener("codeclub:rename-chat", async (e) => {
        const { chatId, newName, projectPath } = e.detail;
        const btn = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
        if (btn) {
          const title = btn.querySelector('.chat-title');
          if (title) title.textContent = newName;
        }
        if (projectPath) {
          try {
            const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
            const metaPath = `${projectPath}/.codeclub/meta.json`;
            if (await exists(metaPath)) {
              const metaContent = await readTextFile(metaPath);
              const metaData = JSON.parse(metaContent);
              if (metaData.chats) {
                const chat = metaData.chats.find(c => c.id === chatId);
                if (chat) {
                  chat.name = newName;
                  await writeTextFile(metaPath, JSON.stringify(metaData));
                }
              }
            }
          } catch(err) { console.error("Error renaming chat in meta", err); }
        }
      });

      document.querySelector(".drag-area")?.addEventListener("dblclick", () => {
        appWindow.toggleMaximize();
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-bg: #111111;
    --color-surface-0: #101010;
    --color-surface-1: #121212;
    --color-surface-2: #161616;
    --color-surface-3: #191919;
    --color-surface-4: #1a1a1a;
    --color-surface-5: #1c1c1c;
    --color-surface-6: #1e1e1e;
    --color-surface-7: #202020;
    --color-surface-8: #2b2b2b;
    --color-surface-9: #2c2c2c;
    --color-surface-10: #2f2f2f;
  }

  html,
  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: transparent;
    color: #dedede;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    overflow: hidden;
  }

  body {
    display: grid;
    grid-template-rows: 36px 1fr;
    grid-template-columns: 0 1fr;
    transition: grid-template-columns 140ms ease;
  }

  body.has-sidebar {
    grid-template-columns: 264px 1fr;
  }

  button {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    cursor: pointer;
  }

  .topbar {
    grid-column: 1 / -1;
    height: 36px;
    display: grid;
    grid-template-columns: auto 1fr 138px;
    background: rgba(17, 17, 17, 0.48);
    border-bottom: 1px solid rgba(47, 47, 47, 1);
    user-select: none;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 36px 0 0;
    background: var(--color-bg);
    z-index: -1;
  }

  .left-panel {
    grid-row: 2;
    grid-column: 1;
    min-width: 264px;
    width: 264px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-top: 1px solid rgba(47, 47, 47, 1);
    border-right: 1px solid var(--color-surface-10);
    background: #161616;
    box-shadow: 12px 0 40px rgba(0, 0, 0, 0.25);
    transform: translateX(-100%);
    transition: transform 140ms ease;
    z-index: 10;
  }

  .left-panel.is-open {
    transform: translateX(0);
  }

  .workspace {
    grid-row: 2;
    grid-column: 2;
    min-width: 0;
    min-height: 0;
    background: transparent;
  }

  .panel-actions {
    display: grid;
    gap: 4px;
    padding: 10px;
  }

  .sidebar-label {
    height: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: #9f9f9f;
    font-size: 12px;
    font-weight: 400;
  }

  .sidebar-footer {
    padding: 10px;
    display: grid;
    gap: 4px;
    border-top: 1px solid var(--color-surface-9);
  }

  .panel-actions button,
  :global(.project-row),
  :global(.chat-row),
  .sidebar-footer button,
  .section-heading button {
    appearance: none !important;
    -webkit-appearance: none !important;
    border: 0 !important;
    background: transparent !important;
    color: #d8d8d8 !important;
  }

  .panel-actions button,
  :global(.project-row),
  .sidebar-footer button,
  :global(.chat-row) {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 7px;
    padding: 0 10px;
    font-size: 12px !important;
    font-family: inherit !important;
    text-align: left;
    cursor: pointer;
  }

  .panel-actions button:hover,
