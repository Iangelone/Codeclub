---
import {
  ArrowLeft,
  ArrowRight,
  Bug,
  FolderPlus,
  Command,
  Eye,
  FilePlus,
  FolderOpen,
  HelpCircle,
  Keyboard,
  Minus,
  Package,
  PiggyBank,
  PanelLeft,
  Search,
  Save,
  Scissors,
  Settings,
  Square,
  Terminal,
  Undo2,
  X,
} from "lucide-astro";
import ChatPanel from "../components/ChatPanel.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>Codeclub Desktop</title>
    <script>
      if (navigator.userAgent.includes("Windows")) {
        document.documentElement.classList.add("is-windows");
      }
    </script>
  </head>
  <body class="has-sidebar">
    <header class="topbar">
      <div class="topbar-left">
        <button class="tool-button" type="button" aria-label="Toggle sidebar">
          <PanelLeft size={15} strokeWidth={1.8} />
        </button>
        <button class="tool-button" type="button" aria-label="Back">
          <ArrowLeft size={15} strokeWidth={1.8} />
        </button>
        <button class="tool-button" type="button" aria-label="Forward">
          <ArrowRight size={15} strokeWidth={1.8} />
        </button>
        <nav class="app-menu" aria-label="Application menu">
          <div class="menu-group">
            <button type="button">Archivo</button>
            <div class="dropdown-menu">
              <a href="#"><FilePlus size={14} /> Nuevo archivo</a>
              <a href="#"><FolderOpen size={14} /> Abrir carpeta</a>
              <a href="#"><Save size={14} /> Guardar</a>
              <a href="#"><Command size={14} /> Exportar</a>
            </div>
          </div>
          <div class="menu-group">
            <button type="button">Editar</button>
            <div class="dropdown-menu">
              <a href="#"><Undo2 size={14} /> Deshacer</a>
              <a href="#"><ArrowRight size={14} /> Rehacer</a>
              <a href="#"><Scissors size={14} /> Cortar</a>
              <a href="#"><Settings size={14} /> Preferencias</a>
            </div>
          </div>
          <div class="menu-group">
            <button type="button">Ver</button>
            <div class="dropdown-menu">
              <a href="#"><PanelLeft size={14} /> Panel lateral</a>
              <a href="#"><Terminal size={14} /> Terminal</a>
              <a href="#"><Square size={14} /> Pantalla completa</a>
              <a href="#"><Eye size={14} /> Apariencia</a>
            </div>
          </div>
          <div class="menu-group help-group">
            <button type="button">Ayuda</button>
            <div class="dropdown-menu">
              <a href="#"><HelpCircle size={14} /> Documentación</a>
              <a href="#"><Keyboard size={14} /> Atajos</a>
              <a href="#"><Bug size={14} /> Reportar problema</a>
              <a href="https://ko-fi.com/codeclubide" target="_blank" rel="noreferrer">
                <PiggyBank size={14} /> Donación
              </a>
            </div>
          </div>
        </nav>
      </div>
      <div class="drag-area" data-tauri-drag-region></div>
      <nav class="window-controls" aria-label="Window controls">
        <button id="minimize" type="button" aria-label="Minimize">
          <Minus size={14} strokeWidth={1.8} />
        </button>
        <button id="maximize" type="button" aria-label="Maximize">
          <Square size={12} strokeWidth={1.8} />
        </button>
        <button id="close" class="close" type="button" aria-label="Close">
          <X size={14} strokeWidth={1.8} />
        </button>
      </nav>
    </header>
    <aside class="left-panel" aria-label="Sidebar">
      <section class="panel-actions">
        <div class="sidebar-label">Espacio de trabajo</div>
        <button type="button">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"></path>
            <path d="M19 3v6"></path>
            <path d="M16 6h6"></path>
          </svg>
          Nuevo chat
        </button>
        <button type="button"><Search size={15} /> Buscar</button>
        <button type="button"><Package size={15} /> Complementos</button>
      </section>
      <section class="projects-section">
        <div class="section-heading">
          <span>Proyectos</span>
          <button id="create-project" type="button" aria-label="Crear proyecto"><FolderPlus size={14} /></button>
        </div>
        <div class="projects-list" aria-label="Lista de proyectos"></div>
      </section>
      <section class="sidebar-footer">
        <button type="button"><Settings size={15} /> Ajustes</button>
      </section>
    </aside>
    <main class="workspace" aria-label="Workspace">
      <ChatPanel />
    </main>

    <script>
      import { getCurrentWindow } from "@tauri-apps/api/window";

      const appWindow = getCurrentWindow();
      const sidebarButton = document.querySelector('[aria-label="Toggle sidebar"]');
      const leftPanel = document.querySelector(".left-panel");
      const createProject = document.querySelector("#create-project");
      const projectsList = document.querySelector(".projects-list");

      const renameProject = (projectRow, projectName) => {
        if (projectRow.querySelector(".project-input")) return;

        const previousName = projectName.textContent ?? "";
        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.value = previousName;
        projectName.replaceWith(input);
        input.focus();
        input.select();
        let isDone = false;

        const finish = () => {
          if (isDone) return;
          isDone = true;
          const nextName = input.value.trim();
          projectName.textContent = nextName || previousName;
          input.replaceWith(projectName);
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (isDone) return;
            isDone = true;
            projectName.textContent = previousName;
            input.replaceWith(projectName);
          }
          if (event.key === "Enter") finish();
        });

        input.addEventListener("blur", finish);
      };

      if (document.body.classList.contains("has-sidebar")) {
        leftPanel?.classList.add("is-open");
      }

      sidebarButton?.addEventListener("click", () => {
        document.body.classList.toggle("has-sidebar");
        leftPanel?.classList.toggle("is-open");
      });

      createProject?.addEventListener("click", () => {
        if (projectsList?.querySelector(".project-input")) return;

        const draft = document.createElement("div");
        draft.className = "project-input-row";
        draft.innerHTML =
          '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>';

        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.placeholder = "Nombre del proyecto";
        draft.append(input);
        projectsList?.prepend(draft);
        input.focus();

        const cancel = () => draft.remove();

        const create = () => {
          const name = input.value.trim();
          if (!name) {
            cancel();
            return;
          }

          const project = document.createElement("div");
          project.className = "project-card";

          const projectRow = document.createElement("button");
          projectRow.className = "project-row";
          projectRow.type = "button";
          projectRow.innerHTML =
            '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
          const projectName = document.createElement("span");
          projectName.textContent = name;
          projectRow.append(projectName);
          projectRow.addEventListener("click", () => {
            projectsList
              ?.querySelectorAll(".project-card")
              .forEach((card) => card.classList.remove("is-active"));
            project.classList.add("is-active");
          });
          projectRow.addEventListener("dblclick", () => {
            renameProject(projectRow, projectName);
          });

          const chatRow = document.createElement("button");
          chatRow.className = "chat-row";
          chatRow.type = "button";
          chatRow.innerHTML =
            '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg><span>Crear chat</span>';

          project.append(projectRow, chatRow);
          projectsList
            ?.querySelectorAll(".project-card")
            .forEach((card) => card.classList.remove("is-active"));
          project.classList.add("is-active");
          draft.replaceWith(project);
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") cancel();
          if (event.key === "Enter") create();
        });
      });

      document.querySelector("#minimize")?.addEventListener("click", () => {
        appWindow.minimize();
      });

      document.querySelector("#maximize")?.addEventListener("click", () => {
        appWindow.toggleMaximize();
      });

      document.querySelector("#close")?.addEventListener("click", () => {
        appWindow.close();
      });

      document.querySelector(".drag-area")?.addEventListener("dblclick", () => {
        appWindow.toggleMaximize();
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-bg: #111111;
    --color-surface-0: #101010;
    --color-surface-1: #121212;
    --color-surface-2: #161616;
    --color-surface-3: #191919;
    --color-surface-4: #1a1a1a;
    --color-surface-5: #1c1c1c;
    --color-surface-6: #1e1e1e;
    --color-surface-7: #202020;
    --color-surface-8: #2b2b2b;
    --color-surface-9: #2c2c2c;
    --color-surface-10: #2f2f2f;
  }

  html,
  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: transparent;
    color: #dedede;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    overflow: hidden;
  }

  body {
    display: grid;
    grid-template-rows: 36px 1fr;
    grid-template-columns: 0 1fr;
    transition: grid-template-columns 140ms ease;
  }

  body.has-sidebar {
    grid-template-columns: 264px 1fr;
  }

  button {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    cursor: default;
  }

  .topbar {
    grid-column: 1 / -1;
    height: 36px;
    display: grid;
    grid-template-columns: auto 1fr 138px;
    background: rgba(17, 17, 17, 0.48);
    border-bottom: 1px solid rgba(47, 47, 47, 1);
    user-select: none;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 36px 0 0;
    background: var(--color-bg);
    z-index: -1;
  }

  .left-panel {
    grid-row: 2;
    grid-column: 1;
    min-width: 264px;
    width: 264px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-top: 1px solid rgba(47, 47, 47, 1);
    border-right: 1px solid var(--color-surface-10);
    background: rgba(18, 18, 18, 0.98);
    box-shadow: 12px 0 40px rgba(0, 0, 0, 0.25);
    transform: translateX(-100%);
    transition: transform 140ms ease;
    z-index: 10;
  }

  .left-panel.is-open {
    transform: translateX(0);
  }

  .workspace {
    grid-row: 2;
    grid-column: 2;
    min-width: 0;
    min-height: 0;
    background: transparent;
  }

  .panel-actions {
    display: grid;
    gap: 4px;
    padding: 10px;
  }

  .sidebar-label {
    height: 24px;
    display: flex;
    align-items: center;
    padding: 0;
    color: #9f9f9f;
    font-size: 12px;
    font-weight: 400;
  }

  .sidebar-footer {
    padding: 10px;
    display: grid;
    gap: 4px;
    border-top: 1px solid var(--color-surface-9);
  }

  .panel-actions button,
  :global(.project-row),
  :global(.chat-row),
  .sidebar-footer button,
  .section-heading button {
    appearance: none !important;
    -webkit-appearance: none !important;
    border: 0 !important;
    background: transparent !important;
    color: #d8d8d8 !important;
  }

  .panel-actions button,
  :global(.project-row),
  .sidebar-footer button,
  :global(.chat-row) {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 7px;
    padding: 0 10px;
    font-size: 12px !important;
    font-family: inherit !important;
    text-align: left;
  }

  .panel-actions button:hover,
  :global(.project-row:hover),
  :global(.chat-row:hover),
  .sidebar-footer button:hover,
  .section-heading button:hover {
    background: var(--color-surface-7);
  }

  .projects-section {
    min-height: 0;
    padding: 10px;
  }

  .section-heading {
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #9f9f9f;
    font-size: 12px;
    font-weight: 400;
  }

  .section-heading button {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .section-heading:hover button,
  .section-heading button:focus-visible {
    opacity: 1;
  }

  .projects-list {
    margin-top: 4px;
    display: grid;
    gap: 4px;
  }

  :global(.project-card) {
    display: grid;
    gap: 3px;
  }

  :global(.project-input-row) {
    min-height: 34px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 10px;
    color: #cfcfcf;
  }

  :global(.project-input) {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    width: 100%;
    height: 22px;
    box-sizing: border-box;
    border: 0;
    background: transparent;
    color: #d8d8d8;
    caret-color: #d8d8d8;
    font: inherit;
    font-size: 12px;
    outline: none;
    padding: 0;
    box-shadow: none;
  }

  :global(.project-input:focus) {
    background: transparent;
    box-shadow: none;
  }

  :global(.project-input::placeholder) {
    color: #8f8f8f;
  }

  :global(.project-row) {
    background: transparent !important;
  }

  :global(.project-row:focus-visible),
  :global(.chat-row:focus-visible) {
    background: var(--color-surface-7) !important;
    outline: none;
  }

  :global(.chat-row) {
    margin-left: 12px;
    color: rgba(216, 216, 216, 0.62) !important;
    opacity: 0.72;
    display: none;
  }

  :global(.project-card.is-active .project-row) {
    background: var(--color-surface-7) !important;
  }

  :global(.project-card.is-active .chat-row) {
    display: flex;
  }

  .is-windows .topbar {
    background: rgba(17, 17, 17, 0.48);
  }

  @supports not (backdrop-filter: blur(1px)) {
    body::before {
      background: var(--color-bg);
    }
  }

  @supports not (backdrop-filter: blur(1px)) {
    .topbar {
      background: var(--color-bg);
    }
  }

  .drag-area {
    min-width: 0;
    height: 100%;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: 6px;
  }

  .tool-button,
  .app-menu button {
    height: 28px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #d8d8d8;
  }

  .tool-button {
    width: 30px;
    display: grid;
    place-items: center;
  }

  .app-menu {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
    height: 100%;
    position: relative;
  }

  .menu-group {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .app-menu button {
    padding: 0 9px;
    font-size: 12px;
  }

  .tool-button:hover,
  .app-menu button:hover {
    background: var(--color-surface-7);
  }

  .dropdown-menu {
    position: absolute;
    top: 34px;
    left: 0;
    min-width: 210px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px;
    border: 1px solid var(--color-surface-10);
    border-radius: 8px;
    background: rgba(18, 18, 18, 0.96);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.38);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
    z-index: 20;
  }

  .menu-group:hover .dropdown-menu,
  .dropdown-menu:hover {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-menu a {
    display: flex;
    min-height: 30px;
    align-items: center;
    gap: 9px;
    border-radius: 7px;
    padding: 0 10px;
    color: #bdbdbd;
    font-size: 12px;
    text-decoration: none;
  }

  .dropdown-menu a:hover {
    background: var(--color-surface-7);
    color: #ffffff;
  }

  .dropdown-menu svg {
    flex: 0 0 auto;
  }


  .window-controls {
    display: grid;
    grid-template-columns: repeat(3, 46px);
  }

  .window-controls button {
    width: 46px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #d8d8d8;
  }

  .window-controls svg {
    display: block;
  }

  .window-controls button:hover {
    background: var(--color-surface-7);
  }

  .window-controls .close:hover {
    background: #c42b1c;
    color: #ffffff;
  }

</style>
