---
import "../styles/global.css";
import Topbar from "../components/Topbar.astro";
import Sidebar from "../components/Sidebar.astro";
import ChatPanel from "../components/ChatPanel.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>Codeclub Desktop</title>
    <script>
      if (navigator.userAgent.includes("Windows")) {
        document.documentElement.classList.add("is-windows");
      }
    </script>
    <script>
      if (typeof process === 'undefined') {
        window.process = { env: {}, cwd: () => '/', nextTick: (fn, ...a) => setTimeout(fn, 0, ...a), platform: 'browser', argv: [], version: '', browser: true };
      }
    </script>
  </head>
  <body class="has-sidebar">
    <Topbar />
    <Sidebar />
    <main class="workspace" aria-label="Workspace">
      <ChatPanel />
    </main>

    <script>
      import { logPersistence, startPersistenceSession, getAppDataFilePath } from "../lib/persistence.ts";
      import { ensureProjectMeta, saveProjectIndex, writeProjectIndex, readProjectIndex } from "../lib/projectManager.ts";

      const initCodeclubApp = async () => {
      const { getCurrentWindow } = await import("@tauri-apps/api/window");
      const appWindow = getCurrentWindow();
      const sidebarButton = document.querySelector('[aria-label="Toggle sidebar"]');
      const leftPanel = document.querySelector(".left-panel");
      const createProject = document.querySelector("#create-project");
      const projectsList = document.querySelector(".projects-list");
      const PROJECTS_INDEX = "projects.json";
      const PROJECTS_BACKUP_INDEX = "projects.backup.json";
      const PERSISTENCE_LOG = "persistence-log.jsonl";
      // Persistencia migrada a src/lib/persistence.ts};

      await startPersistenceSession();
      await logPersistence("dom_ready", projectsList ? "ok" : "error", {
        hasProjectsList: Boolean(projectsList),
      });

      const selectProject = (project) => {
        projectsList?.querySelectorAll(".project-card").forEach((card) => {
          card.classList.toggle("is-selected", card === project);
        });
        projectsList?.querySelectorAll(".chat-row").forEach((chat) => chat.classList.remove("is-active"));
        window.dispatchEvent(new CustomEvent("codeclub:active-project", {
          detail: { projectPath: project?.dataset.path, name: project?.dataset.name },
        }));
        window.dispatchEvent(new CustomEvent("codeclub:open-blank"));
      };

      const selectChat = (chat) => {
        projectsList?.querySelectorAll(".project-card").forEach((card) => card.classList.remove("is-selected"));
        projectsList?.querySelectorAll(".chat-row").forEach((row) => row.classList.remove("is-active"));
        chat.classList.add("is-active");
      };

      const getSidebarTargets = () =>
        Array.from(projectsList?.querySelectorAll(".project-row, .project-card.is-expanded .chat-row") || []);

      const focusSidebarTarget = (target) => {
        if (!target) return;
        target.focus();
        target.scrollIntoView({ block: "nearest" });
      };

      const focusSiblingTarget = (target, direction = 1) => {
        const targets = getSidebarTargets();
        const index = Math.max(0, targets.indexOf(target));
        focusSidebarTarget(targets[Math.min(targets.length - 1, Math.max(0, index + direction))]);
      };
      // Project Manager migrado a src/lib/projectManager.ts};

      const createArtifactRow = (kind, artifact, projectPath) => {
        const row = document.createElement("button");
        row.className = kind === "chat" ? "chat-row chat-item" : `chat-row ${kind}-item`;
        row.type = "button";
        row.tabIndex = -1;
        row.draggable = true;
        row.dataset.kind = kind;
        row.dataset.itemId = artifact.id;
        row.dataset.projectPath = projectPath;
        row.dataset[`${kind}Id`] = artifact.id;

        row.addEventListener("dragstart", (e) => {
          document.body.classList.add("is-dragging-artifact");
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            const payload = JSON.stringify({ kind, id: artifact.id, name: artifact.name, projectPath });
            e.dataTransfer.setData("text/plain", payload);
            e.dataTransfer.setData("application/json", payload);
            
            const preview = document.createElement("div");
            preview.className = "drag-preview";
            preview.textContent = artifact.name || "Nuevo elemento";
            document.body.appendChild(preview);
            e.dataTransfer.setDragImage(preview, 0, 0);
            setTimeout(() => preview.remove(), 0);
          }
        });

        row.addEventListener("dragend", () => {
          document.body.classList.remove("is-dragging-artifact");
        });

        let icon = "";
        if (kind === "note") {
          icon = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12l4 4v14H4z"/><path d="M16 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>';
        } else if (kind === "chat") {
          icon = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
        } else {
          icon = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M4 10h16"/><path d="M10 3v18"/><path d="M15 10v11"/></svg>';
        }
        
        row.innerHTML = `${icon}<span class="chat-title">${artifact.name}</span>`;
        row.addEventListener("click", () => {
          const detail = { projectPath, [`${kind}Id`]: artifact.id, name: artifact.name };
          window.dispatchEvent(new CustomEvent(`codeclub:open-${kind}`, { detail }));
          selectChat(row);
        });
        row.addEventListener("dblclick", () => renameSidebarItem(row));
        return row;
      };

      const renameSidebarItem = (row) => {
        const kind = row.dataset.kind;
        if (!kind || kind === "project" || row.querySelector(".project-input")) return;
        const title = row.querySelector(".chat-title");
        if (!title) return;
        const previousName = title.textContent || "";
        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.value = previousName;
        title.replaceWith(input);
        input.focus();
        input.select();
        let isDone = false;

        const finish = async (save = true) => {
          if (isDone) return;
          isDone = true;
          const nextName = input.value.trim() || previousName;
          const nextTitle = document.createElement("span");
          nextTitle.className = "chat-title";
          nextTitle.textContent = save ? nextName : previousName;
          input.replaceWith(nextTitle);
          if (!save || nextName === previousName) return;

          try {
            const { readTextFile, writeTextFile, exists } = await import("@tauri-apps/plugin-fs");
            const projectPath = row.dataset.projectPath;
            const metaPath = `${projectPath}/.codeclub/meta.json`;
            if (!(await exists(metaPath))) return;
            const metaData = JSON.parse(await readTextFile(metaPath));
            const collection = kind === "chat" ? "chats" : `${kind}s`;
            const item = metaData[collection]?.find((entry) => entry.id === row.dataset.itemId);
            if (item) {
              item.name = nextName;
              await writeTextFile(metaPath, JSON.stringify(metaData));
              window.dispatchEvent(new CustomEvent(`codeclub:renamed-${kind}`, {
                detail: { itemId: row.dataset.itemId, name: nextName, projectPath },
              }));
              if (kind === "chat") window.dispatchEvent(new CustomEvent("codeclub:rename-chat", {
                detail: { chatId: row.dataset.itemId, newName: nextName, projectPath },
              }));
            }
          } catch (error) {
            console.error("Error renaming sidebar item", error);
          }
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter") finish(true);
          if (event.key === "Escape") finish(false);
        });
        input.addEventListener("blur", () => finish(false));
      };

      const deleteSidebarTarget = async (target) => {
        const kind = target.dataset.kind;
        if (!kind) return;
        const nextFocusDirection = 1;

        try {
          if (kind === "project") {
            const project = target.closest(".project-card");
            const projectPath = project?.dataset.path;
            const projects = (await readProjectIndex()).filter((entry) => entry.path !== projectPath);
            await writeProjectIndex(projects);
            focusSiblingTarget(target, nextFocusDirection);
            project?.remove();
            window.dispatchEvent(new CustomEvent("codeclub:open-blank"));
            await logPersistence("delete_project", "ok", { projectPath });
            return;
          }

          const { readTextFile, writeTextFile, exists, remove } = await import("@tauri-apps/plugin-fs");
          const projectPath = target.dataset.projectPath;
          const itemId = target.dataset.itemId;
          const metaPath = `${projectPath}/.codeclub/meta.json`;
          if (!(await exists(metaPath))) return;
          const metaData = JSON.parse(await readTextFile(metaPath));
          const collection = kind === "chat" ? "chats" : `${kind}s`;
          metaData[collection] = (metaData[collection] || []).filter((entry) => entry.id !== itemId);
          await writeTextFile(metaPath, JSON.stringify(metaData));

          const filePath =
            kind === "chat" ? `${projectPath}/.codeclub/chats/${itemId}.jsonl` :
            kind === "note" ? `${projectPath}/.codeclub/notes/${itemId}.md` :
            `${projectPath}/.codeclub/tables/${itemId}.json`;
          if (await exists(filePath)) await remove(filePath);

          // Cleanup memories tagged with this deleted item
          const memoryDir = `${projectPath}/.codeclub/memory`;
          const memoryTag = `${kind}:${itemId}`;
          if (await exists(memoryDir)) {
            const { readDir } = await import("@tauri-apps/plugin-fs");
            const memEntries = await readDir(memoryDir);
            for (const memEntry of memEntries) {
              if (!memEntry.name?.endsWith('.json')) continue;
              const memPath = `${memoryDir}/${memEntry.name}`;
              try {
                const memContent = await readTextFile(memPath);
                const mem = JSON.parse(memContent);
                if (mem.tags?.includes(memoryTag)) {
                  await remove(memPath);
                }
              } catch { /* skip corrupt entries */ }
            }
          }

          focusSiblingTarget(target, nextFocusDirection);
          target.remove();
          window.dispatchEvent(new CustomEvent("codeclub:open-blank"));
          await logPersistence(`delete_${kind}`, "ok", { itemId, projectPath, path: filePath });
        } catch (error) {
          console.error("Error deleting sidebar target", error);
          await logPersistence(`delete_${kind}`, "error", { error: error?.message || String(error) });
        }
      };

      const createArtifact = async (kind, project, projectPath, projectName, beforeRow) => {
        const id = Date.now().toString();
        const name = kind === "note" ? "Nueva nota" : "Nueva tabla";
        const collection = kind === "note" ? "notes" : "tables";
        const extension = kind === "note" ? "md" : "json";
        const initialContent = kind === "note" ? "" : JSON.stringify(Array.from({ length: 8 }, () => Array.from({ length: 5 }, () => "")));

        await ensureProjectMeta(projectPath, projectName);
        const { readTextFile, writeTextFile } = await import("@tauri-apps/plugin-fs");
        const metaPath = `${projectPath}/.codeclub/meta.json`;
        const filePath = `${projectPath}/.codeclub/${collection}/${id}.${extension}`;
        const metaData = JSON.parse(await readTextFile(metaPath));
        if (!Array.isArray(metaData[collection])) metaData[collection] = [];
        const artifact = { id, name };
        metaData[collection].push(artifact);
        await writeTextFile(metaPath, JSON.stringify(metaData));
        await writeTextFile(filePath, initialContent);
        await logPersistence(`create_${kind}`, "ok", { id, projectPath, path: filePath });

        const row = createArtifactRow(kind, artifact, projectPath);
        project.insertBefore(row, beforeRow);
        project.classList.add("is-expanded");
        row.click();
      };

      const renameProject = (projectRow, projectName) => {
        if (projectRow.querySelector(".project-input")) return;

        const previousName = projectName.textContent ?? "";
        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.value = previousName;
        projectName.replaceWith(input);
        input.focus();
        input.select();
        let isDone = false;

        const finish = () => {
          if (isDone) return;
          isDone = true;
          const nextName = input.value.trim();
          const finalName = nextName || previousName;
          projectName.textContent = finalName;
          input.replaceWith(projectName);

          const project = projectRow.closest(".project-card");
          const projectPath = project?.dataset?.path;
          if (projectPath && finalName !== previousName) {
            ensureProjectMeta(projectPath, finalName).catch((error) => console.error("Error renaming project meta", error));
            saveProjectIndex(finalName, projectPath).catch((error) => console.error("Error renaming project index", error));
            logPersistence("rename_project", "ok", { from: previousName, to: finalName, projectPath }).catch(() => {});
          }
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (isDone) return;
            isDone = true;
            projectName.textContent = previousName;
            input.replaceWith(projectName);
          }
          if (event.key === "Enter") finish();
        });

        input.addEventListener("blur", finish);
      };

      if (document.body.classList.contains("has-sidebar")) {
        leftPanel?.classList.add("is-open");
      }
      if (leftPanel && !leftPanel.classList.contains("is-open")) {
        document.body.classList.add("has-sidebar");
        leftPanel.classList.add("is-open");
      }

      sidebarButton?.addEventListener("click", () => {
        document.body.classList.toggle("has-sidebar");
        leftPanel?.classList.toggle("is-open");
      });

      createProject?.addEventListener("click", () => {
        if (projectsList?.querySelector(".project-input")) return;

        const draft = document.createElement("div");
        draft.className = "project-input-row";
        draft.innerHTML =
          '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>';

        const input = document.createElement("input");
        input.className = "project-input";
        input.type = "text";
        input.placeholder = "Nombre del proyecto";
        draft.append(input);
        projectsList?.prepend(draft);
        input.focus();

        const cancel = () => draft.remove();

        const create = async () => {
          const name = input.value.trim();
          if (!name) {
            cancel();
            return;
          }

          try {
            const { open } = await import('@tauri-apps/plugin-dialog');
            
            const selectedPath = await open({
              directory: true,
              multiple: false,
              title: "Seleccionar carpeta para el proyecto",
            });

            if (!selectedPath) {
              cancel();
              return;
            }

            await ensureProjectMeta(selectedPath, name);
            await saveProjectIndex(name, selectedPath);
            await logPersistence("create_project", "ok", { name, projectPath: selectedPath });

            const project = document.createElement("div");
            project.className = "project-card";
            project.dataset.path = selectedPath;

            const projectRow = document.createElement("button");
            projectRow.className = "project-row";
            projectRow.type = "button";
            projectRow.tabIndex = 0;
            projectRow.dataset.kind = "project";
            projectRow.dataset.projectPath = selectedPath;
            projectRow.innerHTML =
              '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
            const projectNameSpan = document.createElement("span");
            projectNameSpan.textContent = name;
            projectNameSpan.style.flex = "1"; // take remaining space
            
            const newChatBtn = document.createElement("button");
            newChatBtn.className = "project-action-btn";
            newChatBtn.type = "button";
            newChatBtn.setAttribute("aria-label", "Crear chat");
            newChatBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg>';
            const newTableBtn = document.createElement("button");
            newTableBtn.className = "project-action-btn";
            newTableBtn.type = "button";
            newTableBtn.setAttribute("aria-label", "Crear tabla");
            newTableBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M4 10h16"/><path d="M10 3v18"/><path d="M15 10v11"/></svg>';
            const newNoteBtn = document.createElement("button");
            newNoteBtn.className = "project-action-btn";
            newNoteBtn.type = "button";
            newNoteBtn.setAttribute("aria-label", "Crear nota");
            newNoteBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12l4 4v14H4z"/><path d="M16 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>';
            const actionGroup = document.createElement("span");
            actionGroup.className = "project-action-group";
            actionGroup.append(newChatBtn, newTableBtn, newNoteBtn);
            
            projectRow.append(projectNameSpan, actionGroup);
            projectRow.addEventListener("click", (e) => {
              if (e.target.closest('.project-action-btn')) return;
              selectProject(project);
              project.classList.toggle("is-expanded");
            });
            projectRow.addEventListener("dblclick", () => {
              renameProject(projectRow, projectNameSpan);
            });

            const chatRow = document.createElement("button");
            chatRow.className = "chat-row";
            chatRow.type = "button";
            chatRow.innerHTML =
              '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg><span>Crear chat</span>';
            const tableRow = document.createElement("button");
            tableRow.className = "chat-row";
            tableRow.type = "button";
            tableRow.innerHTML =
              '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M4 10h16"/><path d="M10 3v18"/><path d="M15 10v11"/></svg><span>Crear tabla</span>';
            const noteRow = document.createElement("button");
            noteRow.className = "chat-row";
            noteRow.type = "button";
            noteRow.innerHTML =
              '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12l4 4v14H4z"/><path d="M16 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg><span>Crear nota</span>';
            
            const createChatLogic = async () => {
              const chatId = Date.now().toString();
              
              try {
                const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
                const metaPath = `${selectedPath}/.codeclub/meta.json`;
                await ensureProjectMeta(selectedPath, name);
                if (await exists(metaPath)) {
                  const metaContent = await readTextFile(metaPath);
                  const metaData = JSON.parse(metaContent);
                  if (!metaData.chats) metaData.chats = [];
                  metaData.chats.push({ id: chatId, name: 'Nuevo chat' });
                  await writeTextFile(metaPath, JSON.stringify(metaData));
                  await logPersistence("create_chat", "ok", {
                    chatId,
                    projectPath: selectedPath,
                    path: metaPath,
                    count: metaData.chats.length,
                  });
                }
              } catch(e) {
                console.error("Error saving chat meta", e);
                await logPersistence("create_chat", "error", {
                  chatId,
                  projectPath: selectedPath,
                  error: e?.message || String(e),
                });
              }

              const newChat = createArtifactRow("chat", { id: chatId, name: "Nuevo chat" }, selectedPath);

              project.insertBefore(newChat, chatRow);
              project.classList.add("is-expanded");
              newChat.click();
            };
            
            chatRow.addEventListener("click", createChatLogic);
            newChatBtn.addEventListener("click", createChatLogic);
            tableRow.addEventListener("click", () => createArtifact("table", project, selectedPath, name, chatRow));
            newTableBtn.addEventListener("click", () => createArtifact("table", project, selectedPath, name, chatRow));
            noteRow.addEventListener("click", () => createArtifact("note", project, selectedPath, name, chatRow));
            newNoteBtn.addEventListener("click", () => createArtifact("note", project, selectedPath, name, chatRow));

            project.append(projectRow, chatRow, tableRow, noteRow);
            project.classList.add("is-expanded");
            selectProject(project);
            draft.replaceWith(project);
          } catch(err) {
            console.error(err);
            cancel();
          }
        };

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") cancel();
          if (event.key === "Enter") create();
        });
      });

      document.querySelector("#minimize")?.addEventListener("click", () => {
        appWindow.minimize();
      });

      document.querySelector("#maximize")?.addEventListener("click", () => {
        appWindow.toggleMaximize();
      });

      document.querySelector("#close")?.addEventListener("click", () => {
        appWindow.close();
      });

      window.addEventListener("codeclub:require-project", () => {
        const createBtn = document.querySelector("#create-project");
        if (createBtn) createBtn.click();
      });

      projectsList?.addEventListener("keydown", async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.classList.contains("project-input")) return;
        const row = target.closest(".project-row, .chat-row");
        if (!(row instanceof HTMLElement)) return;

        if (event.key === "ArrowDown") {
          event.preventDefault();
          focusSiblingTarget(row, 1);
        }

        if (event.key === "ArrowUp") {
          event.preventDefault();
          focusSiblingTarget(row, -1);
        }

        if (event.key === "ArrowRight") {
          const project = row.closest(".project-card");
          if (row.classList.contains("project-row") && project) {
            event.preventDefault();
            project.classList.add("is-expanded");
          }
        }

        if (event.key === "ArrowLeft") {
          const project = row.closest(".project-card");
          if (row.classList.contains("project-row") && project) {
            event.preventDefault();
            project.classList.remove("is-expanded");
          } else if (project) {
            event.preventDefault();
            focusSidebarTarget(project.querySelector(".project-row"));
          }
        }

        if (event.key === "Enter") {
          event.preventDefault();
          row.click();
        }

        if (event.key === "Escape") {
          event.preventDefault();
          projectsList.querySelectorAll(".project-card").forEach((card) => card.classList.remove("is-selected"));
          projectsList.querySelectorAll(".chat-row").forEach((item) => item.classList.remove("is-active"));
          window.dispatchEvent(new CustomEvent("codeclub:open-blank"));
        }

        if (event.key === "Delete") {
          event.preventDefault();
          await deleteSidebarTarget(row);
        }
      });

      // Load existing projects on startup
      const loadProjects = async () => {
        try {
          const { exists, readTextFile } = await import('@tauri-apps/plugin-fs');
          const globalProjects = await readProjectIndex();
          await logPersistence("load_projects", "ok", { count: globalProjects.length });
            
            for (const proj of globalProjects) {
              const project = document.createElement("div");
              project.className = "project-card";
              project.dataset.path = proj.path;

              const projectRow = document.createElement("button");
              projectRow.className = "project-row";
              projectRow.type = "button";
              projectRow.tabIndex = 0;
              projectRow.dataset.kind = "project";
              projectRow.dataset.projectPath = proj.path;
              projectRow.innerHTML =
                '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
              let projectChats = [];
              let projectNotes = [];
              let projectTables = [];
              try {
                const metaPath = `${proj.path}/.codeclub/meta.json`;
                if (await exists(metaPath)) {
                  const metaContent = await readTextFile(metaPath);
                  const metaData = JSON.parse(metaContent);
                  if (metaData.chats) projectChats = metaData.chats;
                  if (metaData.notes) projectNotes = metaData.notes;
                  if (metaData.tables) projectTables = metaData.tables;
                }
              } catch(e) { console.error("Error reading meta for", proj.name, e); }

              const projectNameSpan = document.createElement("span");
              projectNameSpan.textContent = proj.name;
              projectNameSpan.style.flex = "1";
              
              const newChatBtn = document.createElement("button");
              newChatBtn.className = "project-action-btn";
              newChatBtn.type = "button";
              newChatBtn.setAttribute("aria-label", "Crear chat");
              newChatBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg>';
              const newTableBtn = document.createElement("button");
              newTableBtn.className = "project-action-btn";
              newTableBtn.type = "button";
              newTableBtn.setAttribute("aria-label", "Crear tabla");
              newTableBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M4 10h16"/><path d="M10 3v18"/><path d="M15 10v11"/></svg>';
              const newNoteBtn = document.createElement("button");
              newNoteBtn.className = "project-action-btn";
              newNoteBtn.type = "button";
              newNoteBtn.setAttribute("aria-label", "Crear nota");
              newNoteBtn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12l4 4v14H4z"/><path d="M16 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>';
              const actionGroup = document.createElement("span");
              actionGroup.className = "project-action-group";
              actionGroup.append(newChatBtn, newTableBtn, newNoteBtn);
              
              projectRow.append(projectNameSpan, actionGroup);
              
              projectRow.addEventListener("click", (e) => {
                if (e.target.closest('.project-action-btn')) return;
                selectProject(project);
                project.classList.toggle("is-expanded");
              });
              
              projectRow.addEventListener("dblclick", () => {
                renameProject(projectRow, projectNameSpan);
              });

              const chatRow = document.createElement("button");
              chatRow.className = "chat-row";
              chatRow.type = "button";
              chatRow.innerHTML =
                '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14l4-4h12a2 2 0 0 0 2-2v-1"/><path d="M19 3v6"/><path d="M16 6h6"/></svg><span>Crear chat</span>';
              const tableRow = document.createElement("button");
              tableRow.className = "chat-row";
              tableRow.type = "button";
              tableRow.innerHTML =
                '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M4 10h16"/><path d="M10 3v18"/><path d="M15 10v11"/></svg><span>Crear tabla</span>';
              const noteRow = document.createElement("button");
              noteRow.className = "chat-row";
              noteRow.type = "button";
              noteRow.innerHTML =
                '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12l4 4v14H4z"/><path d="M16 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg><span>Crear nota</span>';

              const createChatLogic = async () => {
                const chatId = Date.now().toString();
                
                try {
                  const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
                  const metaPath = `${proj.path}/.codeclub/meta.json`;
                  await ensureProjectMeta(proj.path, proj.name);
                  if (await exists(metaPath)) {
                    const metaContent = await readTextFile(metaPath);
                    const metaData = JSON.parse(metaContent);
                    if (!metaData.chats) metaData.chats = [];
                    metaData.chats.push({ id: chatId, name: 'Nuevo chat' });
                    await writeTextFile(metaPath, JSON.stringify(metaData));
                    await logPersistence("create_chat", "ok", {
                      chatId,
                      projectPath: proj.path,
                      path: metaPath,
                      count: metaData.chats.length,
                    });
                  }
                } catch(e) {
                  console.error("Error saving chat meta", e);
                  await logPersistence("create_chat", "error", {
                    chatId,
                    projectPath: proj.path,
                    error: e?.message || String(e),
                  });
                }

                const newChat = createArtifactRow("chat", { id: chatId, name: "Nuevo chat" }, proj.path);

                project.insertBefore(newChat, chatRow);
                project.classList.add("is-expanded");
                newChat.click();
              };
              
              chatRow.addEventListener("click", createChatLogic);
              newChatBtn.addEventListener("click", createChatLogic);
              tableRow.addEventListener("click", () => createArtifact("table", project, proj.path, proj.name, chatRow));
              newTableBtn.addEventListener("click", () => createArtifact("table", project, proj.path, proj.name, chatRow));
              noteRow.addEventListener("click", () => createArtifact("note", project, proj.path, proj.name, chatRow));
              newNoteBtn.addEventListener("click", () => createArtifact("note", project, proj.path, proj.name, chatRow));
              
              project.append(projectRow);

              projectChats.forEach(chat => {
                const existingChat = createArtifactRow("chat", { id: chat.id, name: chat.name || 'Nuevo chat' }, proj.path);
                project.append(existingChat);
              });

              projectNotes.forEach((note) => {
                project.append(createArtifactRow("note", note, proj.path));
              });

              projectTables.forEach((table) => {
                project.append(createArtifactRow("table", table, proj.path));
              });

              await logPersistence("render_chats", "ok", {
                name: proj.name,
                projectPath: proj.path,
                count: projectChats.length,
                renderedCount: project.querySelectorAll(".chat-item").length,
              });

              project.append(chatRow, tableRow, noteRow);
              projectsList?.append(project);
              await logPersistence("render_project", projectsList ? "ok" : "error", {
                name: proj.name,
                projectPath: proj.path,
                hasProjectsList: Boolean(projectsList),
                renderedCount: projectsList?.querySelectorAll(".project-card").length || 0,
              });
            }
      } catch(e) {
        console.error("Error loading projects on startup", e);
        await logPersistence("load_projects", "error", { error: e?.message || String(e) });
      }
    };

      await loadProjects();

      window.addEventListener("codeclub:rename-chat", async (e) => {
        const { chatId, newName, projectPath } = e.detail;
        const btn = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
        if (btn) {
          const title = btn.querySelector('.chat-title');
          if (title) title.textContent = newName;
        }
        if (projectPath) {
          try {
            const { readTextFile, writeTextFile, exists } = await import('@tauri-apps/plugin-fs');
            const metaPath = `${projectPath}/.codeclub/meta.json`;
            if (await exists(metaPath)) {
              const metaContent = await readTextFile(metaPath);
              const metaData = JSON.parse(metaContent);
              if (metaData.chats) {
                const chat = metaData.chats.find(c => c.id === chatId);
                if (chat) {
                  chat.name = newName;
                  await writeTextFile(metaPath, JSON.stringify(metaData));
                  await logPersistence("rename_chat", "ok", { chatId, newName, projectPath, path: metaPath });
                }
              }
            }
          } catch(err) {
            console.error("Error renaming chat in meta", err);
            await logPersistence("rename_chat", "error", {
              chatId,
              newName,
              projectPath,
              error: err?.message || String(err),
            });
          }
        }
      });

      window.addEventListener("codeclub:rename-artifact", async (e) => {
        const { kind, itemId, projectPath, name } = e.detail || {};
        if (!["note", "table"].includes(kind) || !itemId || !projectPath || !name) return;

        try {
          const { readTextFile, writeTextFile, exists } = await import("@tauri-apps/plugin-fs");
          const metaPath = `${projectPath}/.codeclub/meta.json`;
          if (!(await exists(metaPath))) return;
          const metaData = JSON.parse(await readTextFile(metaPath));
          const collection = `${kind}s`;
          const item = metaData[collection]?.find((entry) => entry.id === itemId);
          if (!item) return;
          item.name = name;
          await writeTextFile(metaPath, JSON.stringify(metaData));

          const row = document.querySelector(`.${kind}-item[data-project-path="${CSS.escape(projectPath)}"][data-item-id="${CSS.escape(itemId)}"]`);
          const title = row?.querySelector(".chat-title");
          if (title) title.textContent = name;
          window.dispatchEvent(new CustomEvent(`codeclub:renamed-${kind}`, {
            detail: { itemId, name, projectPath },
          }));
          await logPersistence(`rename_${kind}`, "ok", { itemId, projectPath, name });
        } catch (error) {
          console.error("Error renaming artifact", error);
          await logPersistence(`rename_${kind}`, "error", { error: error?.message || String(error) });
        }
      });

      document.querySelector(".drag-area")?.addEventListener("dblclick", () => {
        appWindow.toggleMaximize();
      });
      document.querySelectorAll('[data-action="toggle-terminal"]').forEach((el) => {
        el.addEventListener("click", (event) => {
          event.preventDefault();
          window.dispatchEvent(new CustomEvent("codeclub:open-terminal-dock", { detail: { toggle: true } }));
        });
      });

      // Workspace panel controls
      const panelSingleBtn = document.querySelector("#panel-single");
      const panelSplitBtn = document.querySelector("#panel-split");

      const updatePanelButtons = (mode) => {
        panelSingleBtn?.classList.toggle("is-active", mode === "single");
        panelSplitBtn?.classList.toggle("is-active", mode === "split");
      };

      panelSingleBtn?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("codeclub:panel-mode", { detail: { mode: "single" } }));
        updatePanelButtons("single");
      });

      panelSplitBtn?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("codeclub:panel-mode", { detail: { mode: "split" } }));
        updatePanelButtons("split");
      });

      window.addEventListener("codeclub:panel-mode-changed", (e) => {
        updatePanelButtons(e.detail?.mode || "single");
      });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCodeclubApp, { once: true });
      } else {
        initCodeclubApp();
      }
    </script>
  </body>
</html>

