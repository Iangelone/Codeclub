{
  "name": "codeclub-desktop",
  "version": "1.0.4",
  "description": "Local-first desktop IDE for building software with AI agents.",
  "author": "Iangelone",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run desktop:dev",
    "desktop:dev": "npm run electron:compile && node scripts/desktop-dev.mjs",
    "desktop:build": "npm run next:build && npm run electron:compile",
    "next:dev": "next dev --hostname 127.0.0.1",
    "next:build": "next build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:launch": "electron .",
    "electron:dev": "npm run electron:compile && electron .",
    "electron:a11y-debug": "npm run electron:compile && electron . --codeclub-a11y-debug",
    "verify:nvidia": "node scripts/verify-nvidia.mjs",
    "test:chat-history": "npm run electron:compile && node scripts/test-chat-history.mjs",
    "test:agent-graph": "tsx scripts/test-agent-graph.mjs",
    "test:native-commands": "npm run electron:compile && node scripts/test-native-commands.mjs",
    "test:chat-ui": "npm run desktop:build && node scripts/test-chat-ui.mjs",
    "test:page-bootstrap": "node scripts/test-page-bootstrap.mjs",
    "test:external-browser": "npm run electron:compile && node scripts/test-external-browser.mjs",
    "test:browser-extension": "npm run electron:compile && node scripts/test-browser-extension.mjs",
    "test:packaged-win": "node scripts/test-packaged-win.mjs",
    "package:win": "npm run desktop:build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.2",
    "@ai-sdk/google": "^4.0.88",
    "@ai-sdk/mcp": "^2.0.24",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@ai-sdk/react": "^4.0.17",
    "@ai-sdk/tui": "^1.0.35",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.16",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "langchain": "^1.5.15",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "material-icon-theme": "^5.37.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.codeclub.desktop",
    "productName": "Codeclub",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron-dist/**/*",
      "electron/preload.cjs",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/agent-relay.ps1",
        "to": "agent-relay.ps1"
      },
      {
        "from": "electron/computer-use.ps1",
        "to": "computer-use.ps1"
      },
      {
        "from": "public/tesseract",
        "to": "tesseract",
        "filter": [
          "*.traineddata.gz"
        ]
      },
      {
        "from": "browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "vendor/agent-skills",
        "to": "agent-skills"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icono/256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Codeclub"
    },
    "artifactName": "Codeclub Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Iangelone",
      "repo": "Codeclub"
    }
  }
}
