{
  "name": "codeclub-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run desktop:dev",
    "desktop:dev": "npm run electron:compile && node scripts/desktop-dev.mjs",
    "desktop:build": "npm run next:build && npm run electron:compile",
    "next:dev": "next dev --hostname 127.0.0.1",
    "next:build": "next build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:launch": "electron .",
    "electron:dev": "npm run electron:compile && electron ."
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.2",
    "@ai-sdk/mcp": "^2.0.24",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@ai-sdk/react": "^4.0.17",
    "@ai-sdk/tui": "^1.0.35",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@tailwindcss/vite": "^4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.16",
    "electron": "^43.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "tesseract.js": "^7.0.0"
