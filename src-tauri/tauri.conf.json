{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codeclub Desktop",
  "version": "0.1.0",
  "identifier": "com.codeclub.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codeclub Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"],
    "color": "#202633"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["resources/cursors/**/*"]
  }
}
