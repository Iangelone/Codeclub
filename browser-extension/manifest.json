{
  "manifest_version": 3,
  "name": "Codeclub Browser Control",
  "version": "1.0.0",
  "description": "Connects Codeclub to browser tabs so its agent can inspect visible page content and interact when you ask.",
  "key": "",
  "permissions": ["debugger", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:47832/*", "http://127.0.0.1:47833/*", "http://127.0.0.1:47834/*",
    "http://127.0.0.1:47835/*", "http://127.0.0.1:47836/*", "http://127.0.0.1:47837/*",
    "http://127.0.0.1:47838/*", "http://127.0.0.1:47839/*", "http://127.0.0.1:47840/*",
    "http://127.0.0.1:47841/*", "http://127.0.0.1:47842/*"
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Codeclub Browser Control", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
